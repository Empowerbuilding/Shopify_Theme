<script>
(function(){
  const SWAP_API = 'https://n8n.empowerbuilding.ai/webhook/2K5uT9uqKxd1Mp3x/webhook/barnhaus-style-swap';
  const CREDIT_API = 'https://n8n.empowerbuilding.ai/webhook/TGNr00LCQDTUFP9R/webhook/barnhaus-style-credits';
  const ENHANCE_API = 'https://n8n.empowerbuilding.ai/webhook/rt-enhance-prompt';
  const LS_EMAIL = 'bh_style_email';
  const LS_COUNT = 'bh_swap_count';

  let userEmail = localStorage.getItem(LS_EMAIL) || null;
  let swapCount = parseInt(localStorage.getItem(LS_COUNT) || '0');
  let creditsRemaining = null;
  let pendingPreset = null;
  let pendingCustom = null;
  // Map: originalUrl → generatedUrl for before/after toggle
  let aiResults = {};
  let currentOriginalUrl = null;
  let viewingGenerated = true;

  function syncCurrentImage() {
    const activeImg = document.querySelector('.lightbox-image.active img');
    const overlay = document.getElementById('lb-generated-overlay');
    if (activeImg) {
      currentOriginalUrl = activeImg.dataset.originalSrc || activeImg.src;
      updateCompareBar();
      // Show generated overlay if this image has a result and we're viewing generated
      if (overlay) {
        if (aiResults[currentOriginalUrl] && viewingGenerated) {
          overlay.src = aiResults[currentOriginalUrl];
          overlay.style.display = 'block';
        } else {
          overlay.style.display = 'none';
          overlay.src = '';
        }
      }
    }
  }

  // Show/hide Make It Yours button when lightbox opens
  const origOpenLightbox = window.openLightbox;
  window.openLightbox = function(index) {
    origOpenLightbox(index);
    const lbImages = document.querySelectorAll('.lightbox-image');
    const activeImg = lbImages[index]?.querySelector('img');
    if (activeImg) {
      currentOriginalUrl = activeImg.dataset.originalSrc || activeImg.src;
      document.getElementById('lb-make-it-yours').style.display = 'block';
      updateCompareBar();
    }
  };

  // Sync image URL when navigating
  const origLightboxNext = window.lightboxNext;
  window.lightboxNext = function(e) {
    origLightboxNext(e);
    setTimeout(syncCurrentImage, 50);
  };
  const origLightboxPrev = window.lightboxPrevious;
  window.lightboxPrevious = function(e) {
    origLightboxPrev(e);
    setTimeout(syncCurrentImage, 50);
  };

  function updateCompareBar() {
    const bar = document.getElementById('lb-compare-bar');
    if (currentOriginalUrl && aiResults[currentOriginalUrl]) {
      bar.style.display = 'flex';
      viewingGenerated = true;
      updateCompareButtons();
    } else {
      bar.style.display = 'none';
    }
  }

  function updateCompareButtons() {
    document.getElementById('lb-show-generated').style.background = viewingGenerated ? '#B8860B' : 'transparent';
    document.getElementById('lb-show-original').style.background = !viewingGenerated ? '#B8860B' : 'transparent';
  }

  window.lbShowView = function(which) {
    if (!currentOriginalUrl || !aiResults[currentOriginalUrl]) return;
    viewingGenerated = which === 'generated';
    const overlay = document.getElementById('lb-generated-overlay');
    if (overlay) {
      if (viewingGenerated) {
        overlay.src = aiResults[currentOriginalUrl];
        overlay.style.display = 'block';
      } else {
        overlay.style.display = 'none';
      }
    }
    updateCompareButtons();
  };

  window.openStyleDrawer = function() {
    document.getElementById('style-drawer').style.display = 'block';
    document.getElementById('sd-drawer-overlay').style.display = 'block';
    setDrawerState('presets');
    updateCreditBar();
  };

  window.closeStyleDrawer = function() {
    const drawer = document.getElementById('style-drawer');
    drawer.style.transition = 'transform 0.25s ease';
    drawer.style.transform = 'translateY(100%)';
    setTimeout(() => {
      drawer.style.display = 'none';
      drawer.style.transform = '';
      drawer.style.transition = '';
    }, 250);
    document.getElementById('sd-drawer-overlay').style.display = 'none';
  };

  // Swipe down to dismiss: fires when touch starts in top 80px of drawer
  (function() {
    const drawer = document.getElementById('style-drawer');
    if (!drawer) return;
    let startY = 0, lastY = 0, startClientY = 0, active = false;

    drawer.addEventListener('touchstart', function(e) {
      const rect = drawer.getBoundingClientRect();
      const touchY = e.touches[0].clientY;
      // Only initiate drag if touch starts within 80px of top of drawer
      if (touchY - rect.top <= 80) {
        startY = touchY;
        lastY = touchY;
        startClientY = touchY;
        active = true;
        drawer.style.transition = 'none';
      }
    }, { passive: false });

    drawer.addEventListener('touchmove', function(e) {
      if (!active) return;
      const delta = e.touches[0].clientY - startY;
      if (delta > 0) {
        e.preventDefault();
        lastY = e.touches[0].clientY;
        drawer.style.transform = 'translateY(' + delta + 'px)';
      }
    }, { passive: false });

    drawer.addEventListener('touchend', function() {
      if (!active) return;
      active = false;
      const delta = lastY - startY;
      if (delta > 50) {
        closeStyleDrawer();
      } else {
        drawer.style.transition = 'transform 0.2s ease';
        drawer.style.transform = '';
        setTimeout(function(){ drawer.style.transition = ''; }, 200);
      }
    }, { passive: false });
  })();

  function updateCreditBar() {
    const bar = document.getElementById('sd-credit-bar');
    const count = document.getElementById('sd-credit-count');
    if (creditsRemaining !== null) {
      bar.style.display = 'block';
      count.textContent = '✨ ' + creditsRemaining + ' credit' + (creditsRemaining !== 1 ? 's' : '') + ' remaining';
    }
  }

  function setDrawerState(state) {
    const ids = ['sd-header','sd-presets','sd-custom-area','sd-generating','sd-upsell','sd-credit-bar'];
    ids.forEach(id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
    if (state === 'presets') {
      ['sd-header','sd-presets','sd-custom-area'].forEach(id => {
        const el = document.getElementById(id); if (el) el.style.display = id==='sd-presets'?'flex':'block';
      });
      if (creditsRemaining !== null) { const cb = document.getElementById('sd-credit-bar'); if (cb) cb.style.display='block'; }
    } else if (state === 'generating') {
      const el = document.getElementById('sd-generating'); if (el) el.style.display = 'block';
    } else if (state === 'upsell') {
      ['sd-upsell','sd-credit-bar'].forEach(id => { const el = document.getElementById(id); if (el) el.style.display='block'; });
    }
  }

  async function doSwap(preset, customPrompt) {
    if (!currentOriginalUrl) return;
    setDrawerState('generating');

    try {
      const body = { email: userEmail || '', imageUrl: currentOriginalUrl, is_free_swap: swapCount <= 1, product_handle: '{{ product.handle }}', product_title: {{ product.title | json }} };
      if (customPrompt) body.customPrompt = customPrompt;
      else body.preset = preset;

      const res = await fetch(SWAP_API, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
      const data = await res.json();

      if (data.success && data.resultUrl) {
        aiResults[currentOriginalUrl] = data.resultUrl;
        if (data.creditsRemaining !== null && data.creditsRemaining !== undefined) {
          creditsRemaining = data.creditsRemaining;
        }
        // Update lightbox image to show result
        // Show result via overlay — never mutate original img.src
        const overlay = document.getElementById('lb-generated-overlay');
        if (overlay) {
          overlay.src = data.resultUrl;
          overlay.style.display = 'block';
        }
        viewingGenerated = true;
        updateCompareBar();
        // Save cart attributes
        fetch('/cart/update.js', { method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ attributes: { chosen_style: preset || 'Custom', style_image_url: data.resultUrl } }) }).catch(()=>{});
        closeStyleDrawer();
        setDrawerState('presets');
      } else {
        setDrawerState('upsell');
      }
    } catch(e) {
      setDrawerState('presets');
      alert('Something went wrong. Please try again.');
    }
  }

  window.runDrawerSwap = function(preset) {
    swapCount++;
    localStorage.setItem(LS_COUNT, swapCount);
    if (swapCount <= 1) {
      doSwap(preset, null);
    } else if (!userEmail) {
      pendingPreset = preset; pendingCustom = null;
      closeStyleDrawer();
      openGateModal();
    } else if (creditsRemaining !== null && creditsRemaining <= 0) {
      setDrawerState('upsell');
    } else {
      doSwap(preset, null);
    }
  };

  window.runDrawerCustom = function() {
    const prompt = document.getElementById('sd-custom-prompt').value.trim();
    if (!prompt) return;
    swapCount++;
    localStorage.setItem(LS_COUNT, swapCount);
    if (swapCount <= 1) {
      doSwap(null, prompt);
    } else if (!userEmail) {
      pendingPreset = null; pendingCustom = prompt;
      closeStyleDrawer();
      openGateModal();
    } else if (creditsRemaining !== null && creditsRemaining <= 0) {
      setDrawerState('upsell');
    } else {
      doSwap(null, prompt);
    }
  };

  window.enhanceDrawerPrompt = async function() {
    const el = document.getElementById('sd-custom-prompt');
    const prompt = el.value.trim();
    if (!prompt || !currentOriginalUrl) return;
    el.value = 'Enhancing…';
    try {
      const res = await fetch(ENHANCE_API, { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ prompt, imageUrl: currentOriginalUrl }) });
      const data = await res.json();
      if (data.enhancedPrompt) el.value = data.enhancedPrompt;
      else el.value = prompt;
    } catch(e) { el.value = prompt; }
  };

  function openGateModal() {
    document.getElementById('sd-modal').style.display = 'block';
    document.getElementById('sd-modal-error').style.display = 'none';
    document.getElementById('sd-modal-name').focus();
  }

  window.closeGateModal = function() {
    document.getElementById('sd-modal').style.display = 'none';
  };

  window.submitGateModal = async function() {
    const name = document.getElementById('sd-modal-name').value.trim();
    const email = document.getElementById('sd-modal-email').value.trim();
    const phone = document.getElementById('sd-modal-phone').value.trim();
    const errEl = document.getElementById('sd-modal-error');
    if (!name || !email || !phone) { errEl.textContent = 'All fields required.'; errEl.style.display = 'block'; return; }
    if (!/\S+@\S+\.\S+/.test(email)) { errEl.textContent = 'Enter a valid email.'; errEl.style.display = 'block'; return; }
    const btn = document.getElementById('sd-modal-submit');
    btn.textContent = 'Getting credits…'; btn.disabled = true;
    try {
      const res = await fetch(CREDIT_API, { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ email, name, phone, action: 'capture' }) });
      const data = await res.json();
      userEmail = email;
      localStorage.setItem(LS_EMAIL, email);
      creditsRemaining = data.credits_remaining;
      closeGateModal();
      if (pendingPreset || pendingCustom) {
        openStyleDrawer();
        doSwap(pendingPreset, pendingCustom);
        pendingPreset = null; pendingCustom = null;
      }
    } catch(e) { errEl.textContent = 'Something went wrong.'; errEl.style.display = 'block'; }
    btn.textContent = 'Get My 3 Free Credits'; btn.disabled = false;
  };

  // Cache original image URLs so navigating after generation doesn't break the compare bar
  document.querySelectorAll('.lightbox-image img').forEach(img => {
    img.dataset.originalSrc = img.src;
  });

  // On load: check credits if email saved
  if (userEmail) {
    fetch(CREDIT_API, { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ email: userEmail, action: 'check' }) })
      .then(r => r.json()).then(d => { creditsRemaining = d.credits_remaining; }).catch(()=>{});
  }
})();
</script>

