{% comment %}
  Main Product Section
  Displays product images, details, and add to cart functionality
{% endcomment %}

<section class="product-page">
  <!-- Mobile Back Button -->
  <button class="mobile-back-button" onclick="window.location.href='/pages/plans'" aria-label="Go back">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
  </button>

  <div class="container">
    <div class="product-main">
      <!-- Product Gallery (Images & 3D Models) -->
      <div class="product-gallery">
        <div class="product-image-main" id="product-image-main">
          <div class="image-carousel" id="image-carousel">
            {% if product.media.size > 0 %}
              {% for media in product.media %}
                {% if media.media_type == 'image' %}
                  <div class="carousel-image {% if forloop.first %}active{% endif %}" onclick="openLightbox({{ forloop.index0 }})" style="cursor: zoom-in;" data-media-type="image">
                    <img src="{{ media | img_url: '800x800' }}" 
                         alt="{{ media.alt | escape }}"
                         loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                  </div>
                {% elsif media.media_type == 'video' %}
                  <div class="carousel-image {% if forloop.first %}active{% endif %}" data-media-type="video">
                    <video 
                      class="product-video"
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="auto"
                      {% if media.preview_image %}poster="{{ media.preview_image | img_url: '800x800' }}"{% endif %}>
                      {% for source in media.sources %}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {% endfor %}
                      Your browser does not support the video tag.
                    </video>
                    <button class="video-unmute-btn" onclick="toggleVideoMute(event, this)" aria-label="Unmute video">
                      <svg class="muted-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                        <line x1="23" y1="9" x2="17" y2="15"></line>
                        <line x1="17" y1="9" x2="23" y2="15"></line>
                      </svg>
                      <svg class="unmuted-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                      </svg>
                    </button>
                  </div>
                {% endif %}
              {% endfor %}
            {% else %}
              <div class="carousel-image active" data-media-type="image">
                <img src="{{ 'product-placeholder.png' | asset_url }}" alt="Product placeholder">
              </div>
            {% endif %}
          </div>
          
          {% if product.media.size > 1 %}
            <!-- Media Navigation Arrows -->
            <button class="image-nav-btn prev" onclick="previousImage()" aria-label="Previous media">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="image-nav-btn next" onclick="nextImage()" aria-label="Next media">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
            
            <!-- Media Indicators (Dots) -->
            <div class="image-indicators" id="image-indicators">
              {% for media in product.media %}
                <span class="indicator {% if forloop.first %}active{% endif %}" onclick="goToImage({{ forloop.index0 }})"></span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
        
        {% if product.media.size > 1 %}
          <div class="product-thumbnails">
            {% for media in product.media %}
              <div class="product-thumbnail {% if forloop.first %}active{% endif %}" 
                   data-image-index="{{ forloop.index0 }}"
                   data-media-type="{{ media.media_type }}"
                   onclick="goToImage({{ forloop.index0 }})">
                {% if media.media_type == 'image' %}
                  <img src="{{ media | img_url: '100x100' }}" alt="{{ media.alt | escape }}">
                {% elsif media.media_type == 'video' %}
                  <div class="video-thumbnail-icon">
                    <!-- Play Icon Overlay -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="#B8860B" stroke="#B8860B" stroke-width="2">
                      <circle cx="12" cy="12" r="10" fill="rgba(184, 134, 11, 0.3)"></circle>
                      <polygon points="10 8 16 12 10 16 10 8" fill="#B8860B"></polygon>
                    </svg>
                    {% if media.preview_image %}
                      <img src="{{ media.preview_image | img_url: '100x100' }}" alt="{{ media.alt | escape }}" style="position: absolute; inset: 0; object-fit: cover; z-index: 0;">
                    {% endif %}
                  </div>
                  {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      
      <!-- Product Info -->
      <div class="product-info">
        <h1 class="product-title">{{ product.title }}</h1>
        
        {% if product.vendor %}
          <p class="product-vendor" style="color: var(--color-text-gray); margin-bottom: 1rem;">
            {{ product.vendor }}
          </p>
        {% endif %}
        
        <div class="product-price">
          <span id="product-compare-price" style="text-decoration: line-through; opacity: 0.6; font-size: 1.25rem; margin-right: 0.5rem; {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}display: none;{% endunless %}">
            {{ product.selected_or_first_available_variant.compare_at_price | money }}
          </span>
          <span id="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
        </div>
        
        <!-- Product Form -->
        <form method="post" action="/cart/add" id="product-form" class="product-form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="product-variant-id">
          
          <!-- Variant Cards -->
          {% unless product.has_only_default_variant %}
            <div class="variant-cards" id="variant-cards">
              {% for variant in product.variants %}
                {% if variant.title contains 'Takeoff' or variant.title contains 'takeoff' %}{% continue %}{% endif %}
                <div class="variant-card {% if forloop.first %}selected{% endif %}"
                     data-variant-id="{{ variant.id }}"
                     data-price="{{ variant.price }}"
                     data-compare-price="{{ variant.compare_at_price }}"
                     onclick="selectVariantCard(this, {{ variant.id }}, {{ variant.price }}, {{ variant.compare_at_price | default: 0 }})">
                  <div class="variant-card-header">
                    <span class="variant-card-title">{{ variant.title }}</span>
                    <span class="variant-card-price">{{ variant.price | money }}</span>
                  </div>
                  {% if variant.title contains 'Study' or variant.title contains 'study' %}
                    <ul class="variant-card-features">
                      <li>Dimensioned floor plans with room sizes (both levels)</li>
                      <li>All 4 exterior elevations</li>
                      <li>3D dollhouse &amp; exterior renderings</li>
                      <li>Ideal for layout review &amp; HOA submittals</li>
                    </ul>
                    <div class="variant-card-badge">💡 $99 applies as a credit toward the full Construction Set</div>
                  {% elsif variant.title contains 'Construction' or variant.title contains 'construction' %}
                    <ul class="variant-card-features">
                      <li>Floor plans, foundation &amp; column layout</li>
                      <li>All 4 exterior elevations &amp; interior elevations</li>
                      <li>Electrical plans (L1 &amp; L2) with fixture schedule</li>
                      <li>Plumbing plans (L1 &amp; L2) — license for 1 build</li>
                    </ul>
                    <div class="variant-card-badge">✅ Everything your builder needs to break ground</div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endunless %}
          
          <!-- Hidden Quantity (always 1 for floor plans) -->
          <input type="hidden" name="quantity" id="quantity" value="1">
          
          <!-- Material Takeoff Add-On Checkbox -->
          {% assign takeoff_variant = null %}
          {% for variant in product.variants %}
            {% if variant.title contains 'Takeoff' or variant.title contains 'takeoff' %}
              {% assign takeoff_variant = variant %}
            {% endif %}
          {% endfor %}
          {% if takeoff_variant %}
          <label id="takeoff-checkbox-wrapper" style="display:flex;align-items:flex-start;gap:10px;margin-bottom:14px;cursor:pointer;background:#252525;border:1px solid #3a3a3a;border-radius:8px;padding:12px 14px;">
            <input type="checkbox" id="takeoff-checkbox" style="margin-top:3px;accent-color:#B8860B;flex-shrink:0;width:16px;height:16px;" data-takeoff-variant-id="{{ takeoff_variant.id }}">
            <div>
              <span style="color:#fff;font-size:14px;font-weight:600;">Add Architectural Material Takeoff &mdash; <span style="color:#B8860B;">{{ takeoff_variant.price | money }}</span></span>
              <p style="color:#999;font-size:12px;margin:3px 0 0;">Itemized material list for accurate builder quotes.</p>
            </div>
          </label>
          {% endif %}

          <!-- Add to Cart Button -->
          <button type="submit" 
                  class="btn btn-large btn-full-width" 
                  id="add-to-cart-button"
                  {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </form>
        
        {% unless product.tags contains 'style_credits_pack' %}
        {% render 'legal-disclaimer' %}

        {% comment %} Cost Calculator CTA — hidden for non-floor-plan products {% endcomment %}
        <div style="padding: 10px 0 15px;">
          <button
            id="open-calc-btn"
            onclick="openCalcModal()"
            style="
              display: block;
              width: 100%;
              padding: 14px 20px;
              background: linear-gradient(135deg, #B8860B, #DAA520);
              border: none;
              color: #fff;
              font-size: 15px;
              font-weight: 700;
              text-align: center;
              border-radius: 4px;
              box-sizing: border-box;
              cursor: pointer;
              letter-spacing: 0.3px;
            "
            onmouseover="this.style.opacity='0.9'"
            onmouseout="this.style.opacity='1'"
          >
            💰 Estimate My Build Cost
          </button>
        </div>

        {% comment %} Design Concierge Widget (floating) {% endcomment %}
        {% render 'concierge-widget' %}

        {% comment %} ── Cost Calculator Modal ─────────────────────────────── {% endcomment %}
        <div id="calc-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; overflow-y:auto; padding:20px 10px;">
          <div style="max-width:780px; margin:0 auto; background:#1C1C1C; border-radius:12px; border:1px solid #333; padding:28px 24px; position:relative;">
            
            {%- comment -%} Close button {%- endcomment -%}
            <button onclick="closeCalcModal()" style="position:absolute;top:14px;right:16px;background:none;border:none;color:#aaa;font-size:22px;cursor:pointer;line-height:1;">&times;</button>

            <h2 style="color:#fff;font-size:1.5rem;font-weight:700;margin:0 0 4px;">Estimate My Build Cost</h2>
            <p id="calc-plan-name" style="color:#B8860B;font-size:0.9rem;margin:0 0 24px;"></p>

            {%- comment -%} ── STEP 1: INPUTS ────────────────────────────── {%- endcomment -%}
            <div id="calc-step-inputs">
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:18px;">
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Living SF</label>
                  <input id="calc-living" type="number" min="0" step="50"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Patio SF</label>
                  <input id="calc-patio" type="number" min="0" step="50"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
                <div>
                  <label id="calc-garage-label" style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Garage SF</label>
                  <input id="calc-garage" type="number" min="0" step="50"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
              </div>

              <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px;">
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Bedrooms</label>
                  <input id="calc-beds" type="number" min="1" max="10"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Bathrooms</label>
                  <input id="calc-baths" type="number" min="1" max="10" step="0.5"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
              </div>

              {%- comment -%} Finish level {%- endcomment -%}
              <div style="margin-bottom:18px;">
                <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:8px;">Finish Level</label>
                <div style="display:flex;gap:8px;">
                  <button onclick="calcSetTier('economy')" id="calc-tier-economy"
                    style="flex:1;padding:10px;border-radius:6px;border:2px solid #444;background:#252525;color:#ccc;font-size:13px;font-weight:600;cursor:pointer;text-transform:capitalize;transition:all 0.15s;">
                    Economy
                  </button>
                  <button onclick="calcSetTier('standard')" id="calc-tier-standard"
                    style="flex:1;padding:10px;border-radius:6px;border:2px solid #444;background:#B8860B;border-color:#B8860B;color:#fff;font-size:13px;font-weight:600;cursor:pointer;text-transform:capitalize;transition:all 0.15s;">
                    Standard
                  </button>
                  <button onclick="calcSetTier('luxury')" id="calc-tier-luxury"
                    style="flex:1;padding:10px;border-radius:6px;border:2px solid #444;background:#252525;color:#ccc;font-size:13px;font-weight:600;cursor:pointer;text-transform:capitalize;transition:all 0.15s;">
                    Luxury
                  </button>
                </div>
              </div>

              {%- comment -%} Foundation {%- endcomment -%}
              <div style="margin-bottom:18px;">
                <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Foundation</label>
                <select id="calc-foundation" onchange="calcUpdate()"
                  style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;">
                  <option value="slab">Concrete Slab</option>
                  <option value="crawl">Crawl Space (+8%)</option>
                  <option value="basement">Full Basement (+20%)</option>
                </select>
              </div>

              {%- comment -%} Location {%- endcomment -%}
              <div style="margin-bottom:24px;">
                <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Nearest City</label>
                <select id="calc-location" onchange="calcUpdate()"
                  style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;">
                </select>
              </div>

              {%- comment -%} Preview hidden — costs revealed after contact form submit {%- endcomment -%}
              <div id="calc-preview-owner" style="display:none;"></div>
              <div id="calc-preview-gc" style="display:none;"></div>
              <div id="calc-preview-savings" style="display:none;"></div>

              {%- comment -%} Sustainability Score {%- endcomment -%}
              <div style="margin-bottom:18px;">
                <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">
                  Sustainability Score: <span id="calc-sustain-val" style="color:#B8860B;">5</span>/10
                  <span id="sustain-info-btn" onclick="document.getElementById('sustain-tooltip').style.display=document.getElementById('sustain-tooltip').style.display==='none'?'block':'none'"
                    style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border-radius:50%;border:1px solid #666;color:#999;font-size:11px;font-weight:700;cursor:pointer;margin-left:6px;vertical-align:middle;">i</span>
                </label>
                <div id="sustain-tooltip" style="display:none;background:#1a1a1a;border:1px solid #444;border-radius:6px;padding:10px 12px;margin-bottom:8px;color:#aaa;font-size:12px;line-height:1.5;">
                  Reflects how green and energy-efficient your build is. Higher scores add features like solar prep, spray foam insulation, high-efficiency HVAC, rainwater harvesting, and energy-star appliances. Each point above 5 adds ~2% to your build cost.
                </div>
                <input id="calc-sustain" type="range" min="1" max="10" value="5"
                  oninput="document.getElementById('calc-sustain-val').textContent=this.value; calcUpdate();"
                  style="width:100%;accent-color:#B8860B;cursor:pointer;">
                <div style="display:flex;justify-content:space-between;color:#666;font-size:11px;margin-top:4px;">
                  <span>Basic (1)</span><span>Maximum (10)</span>
                </div>
                <p style="color:#666;font-size:11px;margin-top:4px;">+2% cost per point above 5. Solar prep, advanced insulation, energy-efficient systems.</p>
              </div>

              {%- comment -%} Property Grade {%- endcomment -%}
              <div style="margin-bottom:24px;">
                <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:8px;">Property Grade (Slope)</label>
                <div style="display:flex;flex-direction:column;gap:8px;">
                  <label style="display:flex;align-items:center;gap:10px;cursor:pointer;background:#252525;padding:10px 12px;border-radius:6px;border:1px solid #444;">
                    <input type="radio" name="calc-grade" value="1.0" checked style="accent-color:#B8860B;" onchange="calcUpdate()">
                    <span style="color:#ccc;font-size:13px;"><strong style="color:#fff;">Flat</strong> — Level lot, no grading needed</span>
                  </label>
                  <label style="display:flex;align-items:center;gap:10px;cursor:pointer;background:#252525;padding:10px 12px;border-radius:6px;border:1px solid #444;">
                    <input type="radio" name="calc-grade" value="1.05" style="accent-color:#B8860B;" onchange="calcUpdate()">
                    <span style="color:#ccc;font-size:13px;"><strong style="color:#fff;">Slight Grade</strong> — Minor slope, minimal grading (+5%)</span>
                  </label>
                  <label style="display:flex;align-items:center;gap:10px;cursor:pointer;background:#252525;padding:10px 12px;border-radius:6px;border:1px solid #444;">
                    <input type="radio" name="calc-grade" value="1.12" style="accent-color:#B8860B;" onchange="calcUpdate()">
                    <span style="color:#ccc;font-size:13px;"><strong style="color:#fff;">Moderate Grade</strong> — Noticeable slope, retaining walls likely (+12%)</span>
                  </label>
                  <label style="display:flex;align-items:center;gap:10px;cursor:pointer;background:#252525;padding:10px 12px;border-radius:6px;border:1px solid #444;">
                    <input type="radio" name="calc-grade" value="1.22" style="accent-color:#B8860B;" onchange="calcUpdate()">
                    <span style="color:#ccc;font-size:13px;"><strong style="color:#fff;">Steep Grade</strong> — Heavy grading, significant site work (+22%)</span>
                  </label>
                </div>
              </div>

              <button onclick="calcNextStep()"
                style="width:100%;padding:14px;background:linear-gradient(135deg,#B8860B,#DAA520);border:none;border-radius:6px;color:#fff;font-size:15px;font-weight:700;cursor:pointer;">
                Get My Full Estimate →
              </button>
            </div>

            {%- comment -%} ── STEP 2: LEAD FORM ─────────────────────────── {%- endcomment -%}
            <div id="calc-step-form" style="display:none;">
              <div style="background:#B8860B1a;border:1px solid #B8860B55;border-radius:8px;padding:14px;margin-bottom:20px;">
                <p style="color:#DAA520;font-size:13px;font-weight:600;margin:0;">📊 Your estimate is ready! Fill in your info to see the full breakdown.</p>
              </div>

              <div style="display:flex;flex-direction:column;gap:14px;">
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Full Name *</label>
                  <input id="calc-name" type="text" placeholder="Your full name"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;">
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Email Address *</label>
                  <input id="calc-email" type="email" placeholder="your@email.com"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;">
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Phone Number *</label>
                  <input id="calc-phone" type="tel" placeholder="(555) 123-4567"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;">
                  <label style="display:flex;align-items:flex-start;gap:8px;margin-top:8px;cursor:pointer;">
                    <input type="checkbox" style="margin-top:2px;accent-color:#B8860B;flex-shrink:0;">
                    <span style="color:#666;font-size:11px;line-height:1.4;">You are opting into marketing texts from Barnhaus Steel Builders. Msg frequency may vary. Standard msg & data rates may apply. Reply STOP to opt out.</span>
                  </label>
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:8px;">Where are you in your project?</label>
                  <div style="display:flex;flex-direction:column;gap:10px;">
                    <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;">
                      <input type="radio" name="calc-stage" value="gathering_ideas" style="margin-top:2px;accent-color:#B8860B;flex-shrink:0;">
                      <span style="color:#ccc;font-size:13px;line-height:1.4;">I'm just starting to gather ideas.</span>
                    </label>
                    <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;">
                      <input type="radio" name="calc-stage" value="concept_budget" style="margin-top:2px;accent-color:#B8860B;flex-shrink:0;">
                      <span style="color:#ccc;font-size:13px;line-height:1.4;">I have a rough idea and need a 3D Concept & Budget Study.</span>
                    </label>
                    <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;">
                      <input type="radio" name="calc-stage" value="ready_for_bid" style="margin-top:2px;accent-color:#B8860B;flex-shrink:0;">
                      <span style="color:#ccc;font-size:13px;line-height:1.4;">I have full plans and am ready for a construction bid.</span>
                    </label>
                  </div>
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Project Details (Optional)</label>
                  <textarea id="calc-message" rows="3" placeholder="Timeline, questions, special requirements..."
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;resize:vertical;"></textarea>
                </div>
              </div>

              <div id="calc-form-error" style="display:none;background:#7f1d1d33;border:1px solid #ef444455;border-radius:6px;padding:10px 14px;margin-top:14px;">
                <p style="color:#f87171;font-size:13px;margin:0;" id="calc-form-error-msg"></p>
              </div>

              <div style="display:flex;gap:10px;margin-top:20px;">
                <button onclick="calcBackStep()"
                  style="padding:12px 20px;background:none;border:1px solid #444;border-radius:6px;color:#aaa;font-size:14px;cursor:pointer;">
                  ← Back
                </button>
                <button onclick="calcSubmit()" id="calc-submit-btn"
                  style="flex:1;padding:14px;background:linear-gradient(135deg,#B8860B,#DAA520);border:none;border-radius:6px;color:#fff;font-size:15px;font-weight:700;cursor:pointer;">
                  Get Instant Estimate
                </button>
              </div>
            </div>

            {%- comment -%} ── STEP 3: RESULTS ──────────────────────────── {%- endcomment -%}
            <div id="calc-step-results" style="display:none;">
              <div style="background:#14532d33;border:1px solid #22c55e55;border-radius:8px;padding:14px;margin-bottom:20px;">
                <p id="calc-results-thanks" style="color:#4ade80;font-size:13px;font-weight:600;margin:0;">✅ Your estimate is ready!</p>
              </div>

              <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;">
                <div style="background:linear-gradient(135deg,#B8860B22,#DAA52022);border:1px solid #B8860B44;border-radius:8px;padding:16px;">
                  <div style="color:#aaa;font-size:12px;margin-bottom:4px;">Owner-Builder Cost</div>
                  <div id="res-owner" style="color:#DAA520;font-size:1.8rem;font-weight:700;"></div>
                  <div style="color:#999;font-size:12px;margin-top:4px;">With our Blueprint & Roadmap system</div>
                </div>
                <div style="background:#25252588;border:1px solid #333;border-radius:8px;padding:16px;">
                  <div style="color:#aaa;font-size:12px;margin-bottom:4px;">General Contractor Cost</div>
                  <div id="res-gc" style="color:#fff;font-size:1.4rem;font-weight:600;"></div>
                  <div style="color:#999;font-size:12px;margin-top:4px;">Includes 18% contractor markup</div>
                </div>
                <div style="background:#14532d22;border:1px solid #22c55e44;border-radius:8px;padding:16px;">
                  <div style="color:#aaa;font-size:12px;margin-bottom:4px;">Your Potential Savings</div>
                  <div id="res-savings" style="color:#4ade80;font-size:1.4rem;font-weight:600;"></div>
                  <div id="res-savings-pct" style="color:#86efac;font-size:12px;margin-top:4px;"></div>
                </div>
              </div>

              {%- comment -%} Breakdown {%- endcomment -%}
              <div style="border-top:1px solid #333;padding-top:16px;margin-bottom:20px;">
                <h4 style="color:#fff;font-size:14px;font-weight:600;margin:0 0 12px;">Project Breakdown</h4>
                <div id="res-breakdown" style="display:flex;flex-direction:column;gap:8px;font-size:13px;"></div>
              </div>

              <a href="https://crm.empowerbuilding.ai/book/30-minute-consultation?source=shopify_store"
                target="_blank"
                style="display:block;width:100%;padding:14px;background:linear-gradient(135deg,#B8860B,#DAA520);border-radius:6px;color:#fff;font-size:15px;font-weight:700;text-align:center;text-decoration:none;box-sizing:border-box;">
                Schedule Free Consultation →
              </a>
              <p style="color:#666;font-size:12px;text-align:center;margin:10px 0 0;">Free consultation • No obligation • Fast response</p>
            </div>

          </div>
        </div>

        <script src="{{ 'floor-plans-data.js' | asset_url }}"></script>
        <script>
        // ── Data ──────────────────────────────────────────────────────────────
        var CALC_CITIES = [
          {id:"san-antonio",name:"San Antonio, TX",m:1.0},
          {id:"houston",name:"Houston, TX",m:1.15},
          {id:"dallas",name:"Dallas, TX",m:1.12},
          {id:"austin",name:"Austin, TX",m:1.18},
          {id:"oklahoma-city",name:"Oklahoma City, OK",m:0.95},
          {id:"tulsa",name:"Tulsa, OK",m:0.92},
          {id:"little-rock",name:"Little Rock, AR",m:0.90},
          {id:"new-york",name:"New York City, NY",m:2.4},
          {id:"boston",name:"Boston, MA",m:2.1},
          {id:"philadelphia",name:"Philadelphia, PA",m:1.8},
          {id:"pittsburgh",name:"Pittsburgh, PA",m:1.4},
          {id:"miami",name:"Miami, FL",m:1.5},
          {id:"atlanta",name:"Atlanta, GA",m:1.25},
          {id:"nashville",name:"Nashville, TN",m:1.2},
          {id:"charlotte",name:"Charlotte, NC",m:1.18},
          {id:"orlando",name:"Orlando, FL",m:1.3},
          {id:"tampa",name:"Tampa, FL",m:1.28},
          {id:"los-angeles",name:"Los Angeles, CA",m:2.2},
          {id:"san-francisco",name:"San Francisco, CA",m:2.5},
          {id:"san-diego",name:"San Diego, CA",m:2.0},
          {id:"seattle",name:"Seattle, WA",m:2.0},
          {id:"portland",name:"Portland, OR",m:1.8},
          {id:"boise",name:"Boise, ID",m:1.3},
          {id:"chicago",name:"Chicago, IL",m:1.7},
          {id:"minneapolis",name:"Minneapolis, MN",m:1.5},
          {id:"detroit",name:"Detroit, MI",m:1.2},
          {id:"indianapolis",name:"Indianapolis, IN",m:1.1},
          {id:"columbus",name:"Columbus, OH",m:1.12},
          {id:"kansas-city",name:"Kansas City, MO",m:1.05},
          {id:"phoenix",name:"Phoenix, AZ",m:1.3},
          {id:"las-vegas",name:"Las Vegas, NV",m:1.35},
          {id:"albuquerque",name:"Albuquerque, NM",m:1.1},
          {id:"el-paso",name:"El Paso, TX",m:0.95},
          {id:"denver",name:"Denver, CO",m:1.6},
          {id:"salt-lake-city",name:"Salt Lake City, UT",m:1.4},
          {id:"reno",name:"Reno, NV",m:1.45}
        ];

        var CALC_FACTORS = {
          economy:  {bedroom:8000,  bathroom:6000,  garage:45, living:85,  patio:25},
          standard: {bedroom:12000, bathroom:9000,  garage:60, living:110, patio:35},
          luxury:   {bedroom:18000, bathroom:15000, garage:85, living:150, patio:50}
        };
        var CALC_FOUNDATION = {slab:1.0, crawl:1.08, basement:1.2};
        var CALC_MARKUP = 0.18;

        var calcTier = 'standard';
        var calcPlanData = null;

        // ── Init ──────────────────────────────────────────────────────────────
        (function(){
          // Populate city dropdown
          var sel = document.getElementById('calc-location');
          CALC_CITIES.forEach(function(c){
            var o = document.createElement('option');
            o.value = c.id; o.text = c.name;
            sel.appendChild(o);
          });

          // Inject plan data from FloorPlansData
          var handle = {{ product.handle | json }};
          var planTitle = {{ product.title | json }};
          document.getElementById('calc-plan-name').textContent = planTitle;

          if(window.FloorPlansData){
            calcPlanData = window.FloorPlansData.get(handle);
          }
          if(calcPlanData){
            document.getElementById('calc-living').value  = calcPlanData.area   || 0;
            document.getElementById('calc-patio').value   = calcPlanData.patio  || 0;
            document.getElementById('calc-garage').value  = calcPlanData.garage || 0;
            document.getElementById('calc-beds').value    = calcPlanData.beds   || 3;
            document.getElementById('calc-baths').value   = calcPlanData.baths  || 2;
            if(calcPlanData.garageType){
              document.getElementById('calc-garage-label').textContent = calcPlanData.garageType + ' SF';
            }
          } else {
            document.getElementById('calc-living').value = 2000;
            document.getElementById('calc-patio').value  = 200;
            document.getElementById('calc-garage').value = 800;
            document.getElementById('calc-beds').value   = 3;
            document.getElementById('calc-baths').value  = 2;
          }

          calcSetTier('standard');
          calcUpdate();
        })();

        // ── Helpers ───────────────────────────────────────────────────────────
        function calcFmt(n){
          return '$' + Math.round(n).toLocaleString('en-US');
        }

        function calcCompute(){
          var living  = parseFloat(document.getElementById('calc-living').value)  || 0;
          var patio   = parseFloat(document.getElementById('calc-patio').value)   || 0;
          var garage  = parseFloat(document.getElementById('calc-garage').value)  || 0;
          var beds    = parseFloat(document.getElementById('calc-beds').value)    || 0;
          var baths   = parseFloat(document.getElementById('calc-baths').value)   || 0;
          var fndKey  = document.getElementById('calc-foundation').value;
          var locId   = document.getElementById('calc-location').value;
          var sustain = parseFloat(document.getElementById('calc-sustain').value) || 5;
          var gradeEl = document.querySelector('input[name="calc-grade"]:checked');
          var grade   = gradeEl ? parseFloat(gradeEl.value) : 1.0;
          var f = CALC_FACTORS[calcTier];
          var base = (beds*f.bedroom) + (baths*f.bathroom) + (living*f.living) + (garage*f.garage) + (patio*f.patio);
          base *= CALC_FOUNDATION[fndKey] || 1.0;
          base *= grade;
          var sustainBonus = Math.max(0, (sustain - 5) * 0.02);
          base *= (1 + sustainBonus);
          var city = CALC_CITIES.find(function(c){return c.id===locId;});
          base *= city ? city.m : 1.0;
          var gradeLabel = gradeEl ? gradeEl.closest('label').querySelector('strong').textContent : 'Flat';
          return {owner: base, gc: base*(1+CALC_MARKUP), living:living, patio:patio, garage:garage, beds:beds, baths:baths, f:f, city:city, sustain:sustain, grade:grade, gradeLabel:gradeLabel};
        }

        function calcUpdate(){
          var r = calcCompute();
          document.getElementById('calc-preview-owner').textContent   = calcFmt(r.owner);
          document.getElementById('calc-preview-gc').textContent      = calcFmt(r.gc);
          document.getElementById('calc-preview-savings').textContent = calcFmt(r.gc - r.owner);
        }

        function calcSetTier(t){
          calcTier = t;
          ['economy','standard','luxury'].forEach(function(x){
            var btn = document.getElementById('calc-tier-'+x);
            if(x===t){
              btn.style.background='#B8860B'; btn.style.borderColor='#B8860B'; btn.style.color='#fff';
            } else {
              btn.style.background='#252525'; btn.style.borderColor='#444'; btn.style.color='#ccc';
            }
          });
          calcUpdate();
        }

        function openCalcModal(){
          document.getElementById('calc-modal').style.display = 'block';
          document.body.style.overflow = 'hidden';
          calcUpdate();
        }
        function closeCalcModal(){
          document.getElementById('calc-modal').style.display = 'none';
          document.body.style.overflow = '';
        }

        function calcNextStep(){
          document.getElementById('calc-step-inputs').style.display = 'none';
          document.getElementById('calc-step-form').style.display   = 'block';
        }
        function calcBackStep(){
          document.getElementById('calc-step-form').style.display   = 'none';
          document.getElementById('calc-step-inputs').style.display = 'block';
        }

        function calcSubmit(){
          var name  = document.getElementById('calc-name').value.trim();
          var email = document.getElementById('calc-email').value.trim();
          var phone = document.getElementById('calc-phone').value.trim();
          var stage = (document.querySelector('input[name="calc-stage"]:checked')||{}).value || '';
          var msg   = document.getElementById('calc-message').value.trim();
          var errEl = document.getElementById('calc-form-error');
          var errMsg= document.getElementById('calc-form-error-msg');

          if(!name||!email||!phone){
            errMsg.textContent = 'Please fill in your name, email, and phone number.';
            errEl.style.display='block'; return;
          }
          if(!/\S+@\S+\.\S+/.test(email)){
            errMsg.textContent = 'Please enter a valid email address.';
            errEl.style.display='block'; return;
          }
          errEl.style.display='none';

          var btn = document.getElementById('calc-submit-btn');
          btn.textContent = 'Sending...'; btn.disabled = true;

          var r = calcCompute();
          var city = CALC_CITIES.find(function(c){return c.id===document.getElementById('calc-location').value;});

          // Compute all 3 tiers for full payload match (same as Barnhaus website)
          var savedTier = calcTier;
          calcTier = 'economy'; var re = calcCompute();
          calcTier = 'standard'; var rs = calcCompute();
          calcTier = 'luxury'; var rl = calcCompute();
          calcTier = savedTier;

          var fndVal = document.getElementById('calc-foundation').value;
          var locVal = document.getElementById('calc-location').value;
          var sustainVal = parseFloat(document.getElementById('calc-sustain').value) || 5;
          var gradeEl = document.querySelector('input[name="calc-grade"]:checked');
          var gradeLabel = gradeEl ? gradeEl.closest('label').querySelector('strong').textContent : 'Flat';
          var totalSqft = r.living + r.patio + r.garage;

          var payload = {
            // Identity
            name: name, email: email, phone: phone,
            message: msg, project_stage: stage,
            // Dimensions
            bedrooms: r.beds, bathrooms: r.baths,
            living_space: r.living, patio_space: r.patio, garage_space: r.garage,
            total_square_footage: totalSqft,
            // Location
            location: locVal,
            location_name: city ? city.name : '',
            location_multiplier: city ? city.m : 1.0,
            // Build options
            foundation_type: fndVal,
            roof_pitch: 'standard',
            interior_finish: calcTier,
            selected_tier: calcTier,
            sustainability_score: sustainVal,
            property_grade: gradeEl ? gradeEl.value : '1.0',
            property_grade_label: gradeLabel,
            // Economy costs
            economy_owner_cost: Math.round(re.owner),
            economy_contractor_cost: Math.round(re.gc),
            economy_savings: Math.round(re.gc - re.owner),
            economy_savings_percent: Math.round((1 - re.owner/re.gc)*100),
            // Standard costs
            standard_owner_cost: Math.round(rs.owner),
            standard_contractor_cost: Math.round(rs.gc),
            standard_savings: Math.round(rs.gc - rs.owner),
            standard_savings_percent: Math.round((1 - rs.owner/rs.gc)*100),
            // Luxury costs
            luxury_owner_cost: Math.round(rl.owner),
            luxury_contractor_cost: Math.round(rl.gc),
            luxury_savings: Math.round(rl.gc - rl.owner),
            luxury_savings_percent: Math.round((1 - rl.owner/rl.gc)*100),
            // Cost per sqft
            cost_per_sqft_economy: totalSqft > 0 ? Math.round(re.owner/totalSqft) : 0,
            cost_per_sqft_standard: totalSqft > 0 ? Math.round(rs.owner/totalSqft) : 0,
            cost_per_sqft_luxury: totalSqft > 0 ? Math.round(rl.owner/totalSqft) : 0,
            // Summary
            project_summary: r.beds+'BR/'+r.baths+'BA • '+totalSqft+' sq ft • '+(city ? city.name : ''),
            // Shopify-specific
            plan_handle: {{ product.handle | json }},
            plan_title: {{ product.title | json }},
            // Meta / tracking
            form_type: 'Cost Calculator - Complete Data',
            source: 'shopify_cost_calc',
            page_url: window.location.href,
            timestamp: new Date().toISOString(),
            anonymous_id: window.CRMTracking?.getVisitorId() || '',
            fbclid: window.CRMTracking?.getFbclid() || '',
            fbp: (window.CRMTracking?.getFacebookCookies() || {}).fbp || '',
            fbc: (window.CRMTracking?.getFacebookCookies() || {}).fbc || '',
            client_user_agent: navigator.userAgent,
            client_ip_address: ''
          };

          fetch('https://n8n.empowerbuilding.ai/webhook/cost-calculator-webhook', {
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body: JSON.stringify(payload)
          }).catch(function(){}).finally(function(){
            // Show results regardless
            document.getElementById('calc-step-form').style.display   = 'none';
            document.getElementById('calc-step-results').style.display = 'block';
            document.getElementById('calc-results-thanks').textContent = '✅ Thank you, '+name+'! Here are your estimates:';
            document.getElementById('res-owner').textContent    = calcFmt(r.owner);
            document.getElementById('res-gc').textContent       = calcFmt(r.gc);
            document.getElementById('res-savings').textContent  = calcFmt(r.gc - r.owner);
            document.getElementById('res-savings-pct').textContent = Math.round((1-r.owner/r.gc)*100)+'% savings with owner-builder approach';

            var bd = document.getElementById('res-breakdown');
            bd.innerHTML = '';
            var rows = [
              ['Living Space ('+r.living+' SF)', calcFmt(r.living * r.f.living)],
              ['Bedrooms ('+r.beds+')', calcFmt(r.beds * r.f.bedroom)],
              ['Bathrooms ('+r.baths+')', calcFmt(r.baths * r.f.bathroom)]
            ];
            if(r.garage>0) rows.push(['Garage/Shop ('+r.garage+' SF)', calcFmt(r.garage * r.f.garage)]);
            if(r.patio>0)  rows.push(['Patio ('+r.patio+' SF)', calcFmt(r.patio * r.f.patio)]);
            if(city && city.m!==1.0) rows.push(['Location ('+city.name+')', ((city.m-1)*100).toFixed(0)+'%']);
            rows.forEach(function(row){
              bd.innerHTML += '<div style="display:flex;justify-content:space-between;color:#ccc;padding:4px 0;border-bottom:1px solid #2a2a2a;">'
                +'<span>'+row[0]+'</span><span style="color:#fff;font-weight:600;">'+row[1]+'</span></div>';
            });
          });
        }
        </script>


        {% if product.description != blank %}
          <div class="product-description">
            <div class="product-description-content">
              {{ product.description }}
            </div>
          </div>
        {% endif %}

      </div>
    </div>
  </div>
  
  <!-- Media Lightbox Modal (Images & 3D Models) -->
  <div id="image-lightbox" class="lightbox" onclick="closeLightbox(event)">
    <!-- Make It Yours button — centered above nav arrows -->
    <button id="lb-make-it-yours" onclick="event.stopPropagation(); openStyleDrawer()" style="display:none;position:fixed;bottom:110px;left:50%;transform:translateX(-50%);z-index:10000;background:rgba(184,134,11,0.95);color:#fff;border:none;border-radius:24px;padding:10px 22px;font-size:0.88rem;font-weight:700;letter-spacing:0.03em;box-shadow:0 2px 16px rgba(0,0,0,0.5);cursor:pointer;white-space:nowrap;">✨ Make It Yours</button>

    <!-- Before/After toggle -->
    <div id="lb-compare-bar" style="position:fixed;bottom:162px;left:50%;transform:translateX(-50%);z-index:10000;display:none;background:rgba(0,0,0,0.7);border-radius:20px;padding:4px;white-space:nowrap;">
      <button id="lb-show-generated" onclick="event.stopPropagation(); lbShowView('generated')" style="padding:6px 14px;border-radius:16px;border:none;font-size:0.8rem;font-weight:600;cursor:pointer;background:#B8860B;color:#fff;">Generated</button>
      <button id="lb-show-original" onclick="event.stopPropagation(); lbShowView('original')" style="padding:6px 14px;border-radius:16px;border:none;font-size:0.8rem;font-weight:600;cursor:pointer;background:transparent;color:#fff;">Original</button>
    </div>

    <button class="lightbox-close" onclick="closeLightbox(event)" aria-label="Close lightbox">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    
    <div class="lightbox-content">
      <!-- Generated style overlay — shown on top of lightbox image, never changes original img.src -->
      <img id="lb-generated-overlay" src="" alt="AI styled" style="display:none;position:absolute;top:0;left:0;width:100%;height:100%;object-fit:contain;z-index:5;pointer-events:none;" />
      <div class="lightbox-images" id="lightbox-images">
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <div class="lightbox-image {% if forloop.first %}active{% endif %}" data-media-type="image">
                <img src="{{ media | img_url: '1200x1200' }}" 
                     alt="{{ media.alt | escape }}"
                     loading="lazy">
              </div>
            {% elsif media.media_type == 'video' %}
              <div class="lightbox-image {% if forloop.first %}active{% endif %}" data-media-type="video">
                <video 
                  class="lightbox-video"
                  controls
                  playsinline
                  preload="metadata"
                  {% if media.preview_image %}poster="{{ media.preview_image | img_url: '1200x1200' }}"{% endif %}>
                  {% for source in media.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                  Your browser does not support the video tag.
                </video>
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
      
      {% if product.media.size > 1 %}
        <button class="lightbox-nav prev" onclick="lightboxPrevious(event)" aria-label="Previous media">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="lightbox-nav next" onclick="lightboxNext(event)" aria-label="Next media">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
        
        <div class="lightbox-counter" id="lightbox-counter">1 / {{ product.media.size }}</div>
      {% endif %}
    </div>
  </div>

<!-- Style Drawer -->
<div id="style-drawer" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:10001;background:#1C1C1C;border-radius:20px 20px 0 0;border-top:1px solid #333;max-height:55vh;overflow:hidden;" onclick="event.stopPropagation()">
  <!-- Drag handle: lives OUTSIDE the scroll area so it always gets touch events -->
  <div id="sd-drag-handle" style="width:100%;padding:20px 0 20px;text-align:center;cursor:grab;user-select:none;-webkit-tap-highlight-color:transparent;">
    <div style="width:40px;height:4px;background:#555;border-radius:2px;margin:0 auto;pointer-events:none;"></div>
  </div>
  <!-- Inner scrollable content -->
  <div id="sd-inner" style="overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 16px 24px;max-height:calc(55vh - 34px);">
    <div id="sd-header" style="text-align:center;margin-bottom:12px;">
      <h4 style="color:#fff;margin:0 0 4px;font-size:1rem;font-weight:700;">Make It Yours</h4>
      <p style="color:#9ca3af;font-size:0.8rem;margin:0;">Pick a style to visualize this plan</p>
    </div>
    <div id="sd-presets" style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:16px;">
      {% assign presets = "Modern,Rustic,Hill Country,Traditional,Farmhouse,Contemporary,Modern Farmhouse,Coastal,Industrial,Mediterranean" | split: "," %}
      {% for preset in presets %}
        <button class="sd-preset-btn" onclick="runDrawerSwap('{{ preset }}')" style="padding:8px 14px;border-radius:8px;border:1px solid #333;background:#252525;color:#d1d5db;font-size:0.82rem;cursor:pointer;">{{ preset }}</button>
      {% endfor %}
    </div>
    <div id="sd-custom-area" style="border-top:1px solid #333;padding-top:12px;">
      <p style="color:#9ca3af;font-size:0.8rem;margin:0 0 8px;text-align:center;">or describe your own style</p>
      <textarea id="sd-custom-prompt" style="width:100%;background:#252525;border:1px solid #333;border-radius:8px;color:#e5e5e5;padding:10px;font-size:0.85rem;resize:none;box-sizing:border-box;" rows="2" placeholder="e.g. dark cedar siding with black metal roof…"></textarea>
      <div style="display:flex;gap:8px;margin-top:8px;">
        <button onclick="enhanceDrawerPrompt()" style="flex:1;padding:9px;border-radius:8px;border:1px solid #B8860B;background:transparent;color:#B8860B;font-size:0.82rem;cursor:pointer;">✨ Enhance</button>
        <button onclick="runDrawerCustom()" style="flex:1;padding:9px;border-radius:8px;border:none;background:#B8860B;color:#fff;font-size:0.82rem;font-weight:700;cursor:pointer;">Apply Style</button>
      </div>
    </div>
    <div id="sd-generating" style="display:none;text-align:center;padding:16px 0;">
      <p style="color:#B8860B;font-size:0.9rem;margin:0;">✨ Generating your style…</p>
    </div>
    <div id="sd-upsell" style="display:none;text-align:center;padding:12px 0;">
      <p style="color:#9ca3af;font-size:0.85rem;margin:0 0 10px;">You've used all your style credits.</p>
      <a href="/products/5-style-credits" style="display:inline-block;padding:10px 20px;background:#B8860B;color:#fff;border-radius:8px;text-decoration:none;font-size:0.85rem;font-weight:600;">Buy 5 credits for $5 →</a>
    </div>
    <div id="sd-credit-bar" style="display:none;text-align:center;margin-top:12px;">
      <span id="sd-credit-count" style="color:#B8860B;font-size:0.82rem;font-weight:600;"></span>
    </div>
  </div>
</div>
<div id="sd-drawer-overlay" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,0.3);" onclick="closeStyleDrawer()"></div>

<!-- Gate Modal -->
<div id="sd-modal" style="display:none;position:fixed;inset:0;z-index:10002;">
  <div style="position:absolute;inset:0;background:rgba(0,0,0,0.8);" onclick="closeGateModal()"></div>
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#1C1C1C;border:1px solid #333;border-radius:12px;padding:28px;width:90%;max-width:380px;">
    <h4 style="color:#fff;margin:0 0 8px;font-size:1.1rem;">Unlock More Styles</h4>
    <p style="color:#9ca3af;font-size:0.85rem;margin:0 0 16px;">Enter your info to get <strong style="color:#fff;">3 free style credits</strong>.</p>
    <input id="sd-modal-name" type="text" placeholder="Your name" autocomplete="name" style="width:100%;background:#252525;border:1px solid #333;border-radius:8px;color:#e5e5e5;padding:10px;font-size:0.9rem;margin-bottom:10px;box-sizing:border-box;" />
    <input id="sd-modal-email" type="email" placeholder="Email address" autocomplete="email" style="width:100%;background:#252525;border:1px solid #333;border-radius:8px;color:#e5e5e5;padding:10px;font-size:0.9rem;margin-bottom:10px;box-sizing:border-box;" />
    <input id="sd-modal-phone" type="tel" placeholder="Phone number" autocomplete="tel" style="width:100%;background:#252525;border:1px solid #333;border-radius:8px;color:#e5e5e5;padding:10px;font-size:0.9rem;margin-bottom:12px;box-sizing:border-box;" />
    <p id="sd-modal-error" style="color:#f87171;font-size:0.82rem;display:none;margin-bottom:8px;"></p>
    <button id="sd-modal-submit" onclick="submitGateModal()" style="width:100%;padding:12px;background:#B8860B;color:#fff;border:none;border-radius:8px;font-size:0.95rem;font-weight:700;cursor:pointer;">Get My 3 Free Credits</button>
    <button onclick="closeGateModal()" style="position:absolute;top:12px;right:16px;background:none;border:none;color:#9ca3af;font-size:1.1rem;cursor:pointer;">✕</button>
  </div>
</div>
</section>



<script>
  // Product variants data
  const productVariants = {{ product.variants | json }};
  const planFeaturedImageUrl = '{{ product.featured_image | img_url: "160x160" }}';
  const productOptions = {{ product.options_with_values | json }};
  
  // Image carousel management
  let currentImageIndex = 0;
  const carouselImages = document.querySelectorAll('.carousel-image');
  const indicators = document.querySelectorAll('.indicator');
  const thumbnails = document.querySelectorAll('.product-thumbnail');
  
  // Go to specific image
  function goToImage(index) {
    if (index < 0 || index >= carouselImages.length) return;
    
    // Pause video in current slide if it exists
    const currentVideo = carouselImages[currentImageIndex].querySelector('video');
    if (currentVideo) {
      currentVideo.pause();
      currentVideo.currentTime = 0; // Reset to start
    }
    
    // Hide current image
    carouselImages[currentImageIndex].classList.remove('active');
    if (indicators[currentImageIndex]) {
      indicators[currentImageIndex].classList.remove('active');
    }
    if (thumbnails[currentImageIndex]) {
      thumbnails[currentImageIndex].classList.remove('active');
    }
    
    // Show new image
    currentImageIndex = index;
    carouselImages[currentImageIndex].classList.add('active');
    if (indicators[currentImageIndex]) {
      indicators[currentImageIndex].classList.add('active');
    }
    if (thumbnails[currentImageIndex]) {
      thumbnails[currentImageIndex].classList.add('active');
    }
    
    // Auto-play video in new slide if it exists
    const newVideo = carouselImages[currentImageIndex].querySelector('.product-video');
    if (newVideo) {
      newVideo.play().catch(error => {
        console.log('Video autoplay prevented:', error);
      });
    }
  }
  
  // Next image
  function nextImage() {
    const nextIndex = (currentImageIndex + 1) % carouselImages.length;
    goToImage(nextIndex);
  }
  
  // Previous image
  function previousImage() {
    const prevIndex = (currentImageIndex - 1 + carouselImages.length) % carouselImages.length;
    goToImage(prevIndex);
  }
  
  // Touch swipe functionality
  let touchStartX = 0;
  let touchEndX = 0;
  const carousel = document.getElementById('image-carousel');
  
  if (carousel) {
    carousel.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    });
    
    carousel.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    });
  }
  
  function handleSwipe() {
    const swipeThreshold = 50; // Minimum swipe distance
    const diff = touchStartX - touchEndX;
    
    if (Math.abs(diff) > swipeThreshold) {
      if (diff > 0) {
        // Swiped left - next image
        nextImage();
      } else {
        // Swiped right - previous image
        previousImage();
      }
    }
  }
  
  // Keyboard navigation
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft') {
      previousImage();
    } else if (e.key === 'ArrowRight') {
      nextImage();
    }
  });
  
  // Lightbox functionality
  let lightboxCurrentIndex = 0;
  const lightboxImages = document.querySelectorAll('.lightbox-image');
  const lightbox = document.getElementById('image-lightbox');
  const lightboxCounter = document.getElementById('lightbox-counter');
  
  // Open lightbox
  function openLightbox(index) {
    lightboxCurrentIndex = index;
    updateLightboxImage();
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden'; // Prevent background scrolling
  }
  
  // Close lightbox
  function closeLightbox(event) {
    if (event) {
      event.stopPropagation();
      // Only close if clicking the backdrop or close button
      if (event.target === lightbox || event.currentTarget.classList.contains('lightbox-close')) {
        lightbox.classList.remove('active');
        document.body.style.overflow = ''; // Restore scrolling
      }
    } else {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }
  }
  
  // Update lightbox image
  function updateLightboxImage() {
    lightboxImages.forEach((img, idx) => {
      const isActive = idx === lightboxCurrentIndex;
      img.classList.toggle('active', isActive);
      
      // Pause videos that are not active
      const video = img.querySelector('video');
      if (video && !isActive) {
        video.pause();
      }
    });
    
    if (lightboxCounter && lightboxImages.length > 1) {
      lightboxCounter.textContent = `${lightboxCurrentIndex + 1} / ${lightboxImages.length}`;
    }
  }
  
  // Lightbox next image
  function lightboxNext(event) {
    if (event) event.stopPropagation();
    lightboxCurrentIndex = (lightboxCurrentIndex + 1) % lightboxImages.length;
    updateLightboxImage();
  }
  
  // Lightbox previous image
  function lightboxPrevious(event) {
    if (event) event.stopPropagation();
    lightboxCurrentIndex = (lightboxCurrentIndex - 1 + lightboxImages.length) % lightboxImages.length;
    updateLightboxImage();
  }
  
  // Lightbox keyboard navigation
  document.addEventListener('keydown', function(e) {
    if (!lightbox.classList.contains('active')) return;
    
    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowLeft') {
      lightboxPrevious();
    } else if (e.key === 'ArrowRight') {
      lightboxNext();
    }
  });
  
  // Prevent lightbox content clicks from closing
  if (lightbox) {
    const lightboxContent = lightbox.querySelector('.lightbox-content');
    if (lightboxContent) {
      lightboxContent.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }
  }
  
  // Advanced Mobile Image Zoom & Pan
  document.addEventListener('DOMContentLoaded', function() {
    const lightboxImages = document.querySelectorAll('.lightbox-image img');
    
    lightboxImages.forEach(img => {
      let scale = 1;
      let translateX = 0;
      let translateY = 0;
      let lastTouchDistance = 0;
      let lastTouchX = 0;
      let lastTouchY = 0;
      let isDragging = false;
      let isPinching = false;
      let lastTap = 0;
      
      // Double-tap to zoom
      img.addEventListener('touchend', function(e) {
        const currentTime = new Date().getTime();
        const tapLength = currentTime - lastTap;
        
        if (tapLength < 300 && tapLength > 0) {
          // Double tap detected
          e.preventDefault();
          
          if (scale === 1) {
            // Zoom in to 2.5x at tap location
            const rect = img.getBoundingClientRect();
            const touch = e.changedTouches[0];
            const x = touch.clientX - rect.left;
            const y = touch.clientY - rect.top;
            
            scale = 2.5;
            translateX = (rect.width / 2 - x) * (scale - 1);
            translateY = (rect.height / 2 - y) * (scale - 1);
          } else {
            // Zoom out
            scale = 1;
            translateX = 0;
            translateY = 0;
          }
          
          updateTransform(img);
        }
        
        lastTap = currentTime;
      });
      
      // Improved pinch to zoom with better touch handling
      const parentContainer = img.closest('.lightbox-image');
      
      parentContainer.addEventListener('touchstart', function(e) {
        if (e.touches.length === 2) {
          e.preventDefault();
          e.stopPropagation();
          isPinching = true;
          lastTouchDistance = getDistance(e.touches[0], e.touches[1]);
          isDragging = false;
          // Disable transitions while pinching
          img.style.transition = 'none';
        } else if (e.touches.length === 1 && scale > 1) {
          isDragging = true;
          lastTouchX = e.touches[0].clientX;
          lastTouchY = e.touches[0].clientY;
          img.style.transition = 'none';
        }
      }, { passive: false });
      
      parentContainer.addEventListener('touchmove', function(e) {
        if (e.touches.length === 2 && isPinching) {
          // Pinch zoom
          e.preventDefault();
          e.stopPropagation();
          
          const currentDistance = getDistance(e.touches[0], e.touches[1]);
          
          if (lastTouchDistance > 0) {
            const scaleDelta = currentDistance / lastTouchDistance;
            const newScale = scale * scaleDelta;
            
            // Smooth scale change
            scale = Math.max(1, Math.min(newScale, 5)); // Limit between 1x and 5x
            
            // If zooming back to 1x, reset position
            if (scale <= 1.05) {
              scale = 1;
              translateX = 0;
              translateY = 0;
            }
          }
          
          lastTouchDistance = currentDistance;
          // Apply transform immediately without transition
          img.style.transition = 'none';
          img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
        } else if (e.touches.length === 1 && isDragging && scale > 1) {
          // Pan image when zoomed
          e.preventDefault();
          e.stopPropagation();
          
          const deltaX = e.touches[0].clientX - lastTouchX;
          const deltaY = e.touches[0].clientY - lastTouchY;
          
          translateX += deltaX;
          translateY += deltaY;
          
          // Constrain panning to image bounds
          const maxTranslate = (scale - 1) * img.offsetWidth / 2;
          const maxTranslateY = (scale - 1) * img.offsetHeight / 2;
          translateX = Math.max(-maxTranslate, Math.min(translateX, maxTranslate));
          translateY = Math.max(-maxTranslateY, Math.min(translateY, maxTranslateY));
          
          lastTouchX = e.touches[0].clientX;
          lastTouchY = e.touches[0].clientY;
          
          // Apply transform immediately without transition
          img.style.transition = 'none';
          img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
        }
      }, { passive: false });
      
      parentContainer.addEventListener('touchend', function(e) {
        // When fingers are lifted, LOCK IN the current scale permanently
        if (e.touches.length === 0) {
          // All fingers lifted - ABSOLUTELY LOCK the zoom level
          isDragging = false;
          isPinching = false;
          lastTouchDistance = 0;
          
          // Store the final transform values
          const finalTransform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
          
          // Apply with extreme prejudice
          img.style.transition = 'none !important';
          img.style.webkitTransition = 'none !important';
          img.style.transform = finalTransform;
          img.style.webkitTransform = finalTransform;
          
          // Force multiple reflows
          img.offsetHeight;
          void img.offsetWidth;
          
          console.log('🔒 ZOOM LOCKED at scale:', scale, 'Transform:', finalTransform);
          
          // Set attribute as backup
          img.setAttribute('data-locked-transform', finalTransform);
          img.setAttribute('data-locked-scale', scale);
          
          // Keep re-applying the transform for 500ms to fight any CSS
          let lockCount = 0;
          const lockInterval = setInterval(() => {
            img.style.transition = 'none !important';
            img.style.transform = finalTransform;
            lockCount++;
            if (lockCount >= 10) {
              clearInterval(lockInterval);
              console.log('✅ Zoom lock complete after', lockCount, 'applications');
            }
          }, 50);
          
          // After 1 second, allow smooth transitions only for double-tap
          setTimeout(() => {
            if (!isPinching && !isDragging) {
              img.style.transition = 'transform 0.3s ease-out';
            }
          }, 1000);
        } else if (e.touches.length === 1) {
          // One finger left - stop pinching, prepare for dragging
          isPinching = false;
          lastTouchDistance = 0;
          
          if (scale > 1) {
            isDragging = true;
            lastTouchX = e.touches[0].clientX;
            lastTouchY = e.touches[0].clientY;
          }
        }
      }, { passive: true });
      
      // Reset zoom when lightbox closes
      const lightboxElement = img.closest('.lightbox');
      if (lightboxElement) {
        const closeBtn = lightboxElement.querySelector('.lightbox-close');
        const overlay = lightboxElement;
        
        [closeBtn, overlay].forEach(el => {
          if (el) {
            el.addEventListener('click', function() {
              scale = 1;
              translateX = 0;
              translateY = 0;
              updateTransform(img);
            });
          }
        });
      }
      
      function updateTransform(element) {
        // Force update with no transition during active gestures
        element.style.transition = 'none';
        element.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
        // Hide UI when zoomed
        const miy = document.getElementById('lb-make-it-yours');
        const cbar = document.getElementById('lb-compare-bar');
        const zoomed = scale > 1.1;
        if (miy) miy.style.visibility = zoomed ? 'hidden' : 'visible';
        if (cbar && cbar.style.display !== 'none') cbar.style.visibility = zoomed ? 'hidden' : 'visible';
      }
      
      function getDistance(touch1, touch2) {
        const dx = touch1.clientX - touch2.clientX;
        const dy = touch1.clientY - touch2.clientY;
        return Math.sqrt(dx * dx + dy * dy);
      }
      
      // FAILSAFE: Monitor for unwanted transform resets
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
            // If we have a locked transform and we're not actively pinching/dragging
            const lockedTransform = img.getAttribute('data-locked-transform');
            const lockedScale = parseFloat(img.getAttribute('data-locked-scale'));
            
            if (lockedTransform && lockedScale > 1 && !isPinching && !isDragging) {
              const currentTransform = img.style.transform;
              
              // If transform got reset to something else, force it back
              if (currentTransform !== lockedTransform && currentTransform.includes('scale(1)')) {
                console.warn('⚠️ Transform was reset! Re-applying locked transform');
                img.style.transition = 'none !important';
                img.style.transform = lockedTransform;
                scale = lockedScale;
              }
            }
          }
        });
      });
      
      // Start observing
      observer.observe(img, { attributes: true, attributeFilter: ['style'] });
    });
  });
  
  // Format price in cents to currency string
  function formatMoney(cents) {
    if (window.Shopify && Shopify.formatMoney) {
      return Shopify.formatMoney(cents, '{{ shop.money_format }}');
    }
    return '$' + (cents / 100).toFixed(2);
  }

  // Update variant based on selected options
  function updateVariant() {
    const selectedOptions = [];
    document.querySelectorAll('.form-select').forEach(function(select) {
      selectedOptions.push(select.value);
    });

    // Find matching variant
    const variant = productVariants.find(function(v) {
      return v.options.every(function(option, index) {
        return option === selectedOptions[index];
      });
    });

    if (variant) {
      // Update variant ID
      document.getElementById('product-variant-id').value = variant.id;

      // Update price
      const priceElement = document.getElementById('product-price');
      if (priceElement) {
        priceElement.textContent = formatMoney(variant.price);
      }

      // Update compare-at price (show only if variant has a compare_at_price)
      const comparePriceElement = document.getElementById('product-compare-price');
      if (comparePriceElement) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          comparePriceElement.textContent = formatMoney(variant.compare_at_price);
          comparePriceElement.style.display = 'inline';
        } else {
          comparePriceElement.style.display = 'none';
        }
      }

      // Update availability
      const button = document.getElementById('add-to-cart-button');
      if (variant.available) {
        button.disabled = false;
        button.textContent = 'Add to Cart';
      } else {
        button.disabled = true;
        button.textContent = 'Sold Out';
      }
      
      // Update image if variant has one
      if (variant.featured_image && variant.featured_image.src) {
        const mainImage = document.getElementById('main-product-image');
        if (mainImage) {
          mainImage.src = variant.featured_image.src;
        }
      }
    }
  }
  
  // Quantity controls
  function increaseQuantity() {
    const input = document.getElementById('quantity');
    input.value = parseInt(input.value) + 1;
  }
  
  function decreaseQuantity() {
    const input = document.getElementById('quantity');
    if (parseInt(input.value) > 1) {
      input.value = parseInt(input.value) - 1;
    }
  }
  
  function validateQuantity() {
    const input = document.getElementById('quantity');
    if (parseInt(input.value) < 1) {
      input.value = 1;
    }
  }
  
  // Handle add to cart form submission
  document.getElementById('product-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const button = document.getElementById('add-to-cart-button');
    const originalText = button.textContent;
    const variantInputVal = document.getElementById('product-variant-id').value;
    const selectedVariantId = variantInputVal ? parseInt(variantInputVal) : null;
    const takeoffCheckbox = document.getElementById('takeoff-checkbox');
    const takeoffChecked = takeoffCheckbox && takeoffCheckbox.checked;
    const takeoffVariantId = takeoffCheckbox ? parseInt(takeoffCheckbox.dataset.takeoffVariantId) : null;

    // Validate — must have at least one item
    if (!selectedVariantId && !takeoffChecked) {
      alert('Please select a plan or add the Material Takeoff.');
      return;
    }

    const items = [];
    if (selectedVariantId) items.push({ id: selectedVariantId, quantity: 1 });
    if (takeoffChecked && takeoffVariantId) {
      items.push({ id: takeoffVariantId, quantity: 1, properties: { '_image': planFeaturedImageUrl } });
    }

    button.disabled = true;
    button.textContent = 'Adding...';
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items })
    })
    .then(response => response.json())
    .then(data => {
      // Update cart count
      fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {
          updateCartCount(cart.item_count);
        });

      // Fire Meta AddToCart pixel event
      if (typeof fbq !== 'undefined') {
        var variantPrice = parseFloat(document.getElementById('product-price')?.textContent?.replace(/[^0-9.]/g, '') || '0');
        fbq('track', 'AddToCart', {
          content_ids: [{{ product.id | json }}],
          content_name: {{ product.title | json }},
          content_type: 'product',
          value: variantPrice,
          currency: 'USD'
        });
      }

      button.textContent = 'Added! ✓';
      
      // Automatically open cart drawer
      setTimeout(function() {
        openCartDrawer();
      }, 500);
      
      setTimeout(function() {
        button.disabled = false;
        button.textContent = originalText;
      }, 2000);
    })
    .catch(error => {
      console.error('Error:', error);
      button.disabled = false;
      button.textContent = originalText;
      alert('There was an error adding the product to your cart. Please try again.');
    });
  });
  
  // Toggle video mute/unmute
  function toggleVideoMute(event, button) {
    event.stopPropagation();
    
    const videoContainer = button.closest('.carousel-image');
    const video = videoContainer.querySelector('video');
    const mutedIcon = button.querySelector('.muted-icon');
    const unmutedIcon = button.querySelector('.unmuted-icon');
    
    if (video.muted) {
      video.muted = false;
      mutedIcon.style.display = 'none';
      unmutedIcon.style.display = 'block';
      button.setAttribute('aria-label', 'Mute video');
    } else {
      video.muted = true;
      mutedIcon.style.display = 'block';
      unmutedIcon.style.display = 'none';
      button.setAttribute('aria-label', 'Unmute video');
    }
  }
  
  // Variant card selection
  function applyVariantCard(card, variantId, price, comparePrice) {
    // Internal: select a card without toggle logic (used on init)
    document.querySelectorAll('.variant-card').forEach(function(c) {
      c.classList.remove('selected');
    });
    card.classList.add('selected');
    document.getElementById('product-variant-id').value = variantId;
    const priceEl = document.getElementById('product-price');
    if (priceEl) priceEl.textContent = formatMoney(price);
    const compareEl = document.getElementById('product-compare-price');
    if (compareEl) {
      if (comparePrice && comparePrice > price) {
        compareEl.textContent = formatMoney(comparePrice);
        compareEl.style.display = 'inline';
      } else {
        compareEl.style.display = 'none';
      }
    }
  }

  function selectVariantCard(card, variantId, price, comparePrice) {
    // Toggle off if already selected (takeoff-only purchase)
    if (card.classList.contains('selected')) {
      card.classList.remove('selected');
      document.getElementById('product-variant-id').value = '';
      return;
    }
    // Remove selected from all cards
    document.querySelectorAll('.variant-card').forEach(function(c) {
      c.classList.remove('selected');
    });
    // Select clicked card
    card.classList.add('selected');
    // Update hidden input
    document.getElementById('product-variant-id').value = variantId;
    // Update displayed price
    const priceEl = document.getElementById('product-price');
    if (priceEl) priceEl.textContent = formatMoney(price);
    const compareEl = document.getElementById('product-compare-price');
    if (compareEl) {
      if (comparePrice && comparePrice > price) {
        compareEl.textContent = formatMoney(comparePrice);
        compareEl.style.display = 'inline';
      } else {
        compareEl.style.display = 'none';
      }
    }
  }

  // Sync price with selected variant on page load
  document.addEventListener('DOMContentLoaded', function() {
    // Select first variant card by default
    const firstCard = document.querySelector('.variant-card');
    if (firstCard) {
      const vid = parseInt(firstCard.getAttribute('data-variant-id'));
      const price = parseInt(firstCard.getAttribute('data-price'));
      const compare = parseInt(firstCard.getAttribute('data-compare-price')) || 0;
      applyVariantCard(firstCard, vid, price, compare);
    } else {
      updateVariant();
    }
  });

  // Auto-play first video on page load
  document.addEventListener('DOMContentLoaded', function() {
    const firstSlide = document.querySelector('.carousel-image.active');
    if (firstSlide && firstSlide.getAttribute('data-media-type') === 'video') {
      const video = firstSlide.querySelector('.product-video');
      if (video) {
        video.play().catch(error => {
          console.log('Video autoplay on load prevented:', error);
        });
      }
    }
  });
  
  // Video Interaction Handling - Prevent lightbox from opening when clicking on videos
  document.addEventListener('DOMContentLoaded', function() {
    const carouselVideos = document.querySelectorAll('.carousel-image[data-media-type="video"]');
    
    carouselVideos.forEach((videoContainer) => {
      const video = videoContainer.querySelector('video');
      
      if (video) {
        // Prevent lightbox from opening when clicking on video
        video.addEventListener('click', function(e) {
          e.stopPropagation();
        });
        
        videoContainer.onclick = function(e) {
          // Prevent lightbox opening when clicking on video container
          e.stopPropagation();
        };
      }
    });
    
    // Handle lightbox videos - prevent closing when interacting
    const lightboxVideos = document.querySelectorAll('.lightbox-image[data-media-type="video"] video');
    
    lightboxVideos.forEach((video) => {
      video.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    });
  });
  

  

</script>

