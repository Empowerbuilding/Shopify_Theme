{% comment %}
  Main Product Section
  Displays product images, details, and add to cart functionality
{% endcomment %}

<section class="product-page">
  <!-- Mobile Back Button -->
  <button class="mobile-back-button" onclick="window.history.back()" aria-label="Go back">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
  </button>

  <div class="container">
    <div class="product-main">
      <!-- Product Gallery (Images & 3D Models) -->
      <div class="product-gallery">
        <div class="product-image-main" id="product-image-main">
          <div class="image-carousel" id="image-carousel">
            {% if product.media.size > 0 %}
              {% for media in product.media %}
                {% if media.media_type == 'image' %}
                  <div class="carousel-image {% if forloop.first %}active{% endif %}" onclick="openLightbox({{ forloop.index0 }})" style="cursor: zoom-in;" data-media-type="image">
                    <img src="{{ media | img_url: '800x800' }}" 
                         alt="{{ media.alt | escape }}"
                         loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                  </div>
                {% elsif media.media_type == 'video' %}
                  <div class="carousel-image {% if forloop.first %}active{% endif %}" data-media-type="video">
                    <video 
                      class="product-video"
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="auto"
                      {% if media.preview_image %}poster="{{ media.preview_image | img_url: '800x800' }}"{% endif %}>
                      {% for source in media.sources %}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {% endfor %}
                      Your browser does not support the video tag.
                    </video>
                    <button class="video-unmute-btn" onclick="toggleVideoMute(event, this)" aria-label="Unmute video">
                      <svg class="muted-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                        <line x1="23" y1="9" x2="17" y2="15"></line>
                        <line x1="17" y1="9" x2="23" y2="15"></line>
                      </svg>
                      <svg class="unmuted-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                      </svg>
                    </button>
                  </div>
                {% elsif media.media_type == 'model' %}
                  <div class="carousel-image {% if forloop.first %}active{% endif %}" data-media-type="model">
                    {% assign model_src = '' %}
                    {% for source in media.sources %}
                      {% if source.format == 'glb' %}
                        {% assign model_src = source.url %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    {% if model_src == '' %}
                      {% assign model_src = media.sources[0].url %}
                    {% endif %}
                    <model-viewer 
                      src="{{ model_src }}"
                      {% if media.preview_image %}poster="{{ media.preview_image | img_url: '800x800' }}"{% endif %}
                      alt="{{ media.alt | escape }}"
                      auto-rotate
                      auto-rotate-delay="0"
                      camera-controls
                      interaction-prompt="auto"
                      touch-action="pan-y"
                      camera-orbit="45deg 75deg 25m"
                      min-camera-orbit="auto auto 10m"
                      max-camera-orbit="auto auto 50m"
                      field-of-view="40deg"
                      camera-target="auto auto auto"
                      ar
                      ar-modes="webxr scene-viewer quick-look"
                      shadow-intensity="1"
                      class="product-model-viewer"
                      data-media-id="{{ media.id }}">
                    </model-viewer>
                  </div>
                {% endif %}
              {% endfor %}
            {% else %}
              <div class="carousel-image active" data-media-type="image">
                <img src="{{ 'product-placeholder.png' | asset_url }}" alt="Product placeholder">
              </div>
            {% endif %}
          </div>
          
          {% if product.media.size > 1 %}
            <!-- Media Navigation Arrows -->
            <button class="image-nav-btn prev" onclick="previousImage()" aria-label="Previous media">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="image-nav-btn next" onclick="nextImage()" aria-label="Next media">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
            
            <!-- Media Indicators (Dots) -->
            <div class="image-indicators" id="image-indicators">
              {% for media in product.media %}
                <span class="indicator {% if forloop.first %}active{% endif %}" onclick="goToImage({{ forloop.index0 }})"></span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
        
        {% if product.media.size > 1 %}
          <div class="product-thumbnails">
            {% for media in product.media %}
              <div class="product-thumbnail {% if forloop.first %}active{% endif %}" 
                   data-image-index="{{ forloop.index0 }}"
                   data-media-type="{{ media.media_type }}"
                   onclick="goToImage({{ forloop.index0 }})">
                {% if media.media_type == 'image' %}
                  <img src="{{ media | img_url: '100x100' }}" alt="{{ media.alt | escape }}">
                {% elsif media.media_type == 'video' %}
                  <div class="video-thumbnail-icon">
                    <!-- Play Icon Overlay -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="#B8860B" stroke="#B8860B" stroke-width="2">
                      <circle cx="12" cy="12" r="10" fill="rgba(184, 134, 11, 0.3)"></circle>
                      <polygon points="10 8 16 12 10 16 10 8" fill="#B8860B"></polygon>
                    </svg>
                    {% if media.preview_image %}
                      <img src="{{ media.preview_image | img_url: '100x100' }}" alt="{{ media.alt | escape }}" style="position: absolute; inset: 0; object-fit: cover; z-index: 0;">
                    {% endif %}
                  </div>
                {% elsif media.media_type == 'model' %}
                  <div class="model-thumbnail-icon">
                    <!-- 3D Cube Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2">
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                      <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                    {% if media.preview_image %}
                      <img src="{{ media.preview_image | img_url: '100x100' }}" alt="{{ media.alt | escape }}" style="opacity: 0.3; position: absolute; inset: 0; object-fit: cover;">
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      
      <!-- Product Info -->
      <div class="product-info">
        <h1 class="product-title">{{ product.title }}</h1>
        
        {% if product.vendor %}
          <p class="product-vendor" style="color: var(--color-text-gray); margin-bottom: 1rem;">
            {{ product.vendor }}
          </p>
        {% endif %}
        
        <div class="product-price">
          <span id="product-compare-price" style="text-decoration: line-through; opacity: 0.6; font-size: 1.25rem; margin-right: 0.5rem; {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}display: none;{% endunless %}">
            {{ product.selected_or_first_available_variant.compare_at_price | money }}
          </span>
          <span id="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
        </div>
        
        <!-- Product Form -->
        <form method="post" action="/cart/add" id="product-form" class="product-form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="product-variant-id">
          
          <!-- Variants -->
          {% unless product.has_only_default_variant %}
            <div class="product-options">
              {% for option in product.options_with_values %}
                <div class="form-group">
                  <label class="form-label" for="option-{{ option.name | handleize }}">
                    {{ option.name }}
                  </label>
                  <select class="form-select" 
                          id="option-{{ option.name | handleize }}"
                          name="options[{{ option.name | escape }}]"
                          onchange="updateVariant()">
                    {% for value in option.values %}
                      <option value="{{ value | escape }}" 
                              {% if option.selected_value == value %}selected{% endif %}>
                        {{ value }}
                      </option>
                    {% endfor %}
                  </select>
                </div>
              {% endfor %}
            </div>
          {% endunless %}
          
          <!-- Hidden Quantity (always 1 for floor plans) -->
          <input type="hidden" name="quantity" id="quantity" value="1">
          
          <!-- Add to Cart Button -->
          <button type="submit" 
                  class="btn btn-large btn-full-width" 
                  id="add-to-cart-button"
                  {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </form>
        
        {% render 'legal-disclaimer' %}

        {% comment %} Design Consultation CTA {% endcomment %}
        <div style="padding: 15px 0;">
          <p style="text-align: center; margin-bottom: 10px; font-size: 14px; color: #e5e7eb;">
            Have questions about this plan?
          </p>
          <a
            href="https://crm.empowerbuilding.ai/book/30-minute-consultation?fbp=fb.1.1753229478202.141479004560920050&source=shopify_store"
            target="_blank"
            rel="noopener noreferrer"
            style="
              display: block;
              width: 100%;
              padding: 14px 20px;
              border: 2px solid #B8860B;
              background: transparent;
              color: #e5e7eb;
              font-size: 15px;
              font-weight: 600;
              text-align: center;
              text-decoration: none;
              border-radius: 4px;
              box-sizing: border-box;
              cursor: pointer;
            "
            onmouseover="this.style.background='rgba(184,134,11,0.15)'"
            onmouseout="this.style.background='transparent'"
          >
            Schedule a Free Design Consultation
          </a>
          <p style="text-align: center; margin-top: 10px; font-size: 12px; color: #9ca3af;">
            Our team can walk you through engineering requirements and customization options.
          </p>
        </div>

        {% comment %} Cost Calculator CTA {% endcomment %}
        <div style="padding: 10px 0 15px;">
          <button
            id="open-calc-btn"
            onclick="openCalcModal()"
            style="
              display: block;
              width: 100%;
              padding: 14px 20px;
              background: linear-gradient(135deg, #B8860B, #DAA520);
              border: none;
              color: #fff;
              font-size: 15px;
              font-weight: 700;
              text-align: center;
              border-radius: 4px;
              box-sizing: border-box;
              cursor: pointer;
              letter-spacing: 0.3px;
            "
            onmouseover="this.style.opacity='0.9'"
            onmouseout="this.style.opacity='1'"
          >
            💰 Estimate My Build Cost
          </button>
        </div>

        {% comment %} ── Cost Calculator Modal ─────────────────────────────── {% endcomment %}
        <div id="calc-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; overflow-y:auto; padding:20px 10px;">
          <div style="max-width:780px; margin:0 auto; background:#1C1C1C; border-radius:12px; border:1px solid #333; padding:28px 24px; position:relative;">
            
            {%- comment -%} Close button {%- endcomment -%}
            <button onclick="closeCalcModal()" style="position:absolute;top:14px;right:16px;background:none;border:none;color:#aaa;font-size:22px;cursor:pointer;line-height:1;">&times;</button>

            <h2 style="color:#fff;font-size:1.5rem;font-weight:700;margin:0 0 4px;">Estimate My Build Cost</h2>
            <p id="calc-plan-name" style="color:#B8860B;font-size:0.9rem;margin:0 0 24px;"></p>

            {%- comment -%} ── STEP 1: INPUTS ────────────────────────────── {%- endcomment -%}
            <div id="calc-step-inputs">
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:18px;">
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Living SF</label>
                  <input id="calc-living" type="number" min="0" step="50"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Patio SF</label>
                  <input id="calc-patio" type="number" min="0" step="50"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
                <div>
                  <label id="calc-garage-label" style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Garage SF</label>
                  <input id="calc-garage" type="number" min="0" step="50"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
              </div>

              <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px;">
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Bedrooms</label>
                  <input id="calc-beds" type="number" min="1" max="10"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Bathrooms</label>
                  <input id="calc-baths" type="number" min="1" max="10" step="0.5"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;"
                    oninput="calcUpdate()" onfocus="this.select()">
                </div>
              </div>

              {%- comment -%} Finish level {%- endcomment -%}
              <div style="margin-bottom:18px;">
                <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:8px;">Finish Level</label>
                <div style="display:flex;gap:8px;">
                  <button onclick="calcSetTier('economy')" id="calc-tier-economy"
                    style="flex:1;padding:10px;border-radius:6px;border:2px solid #444;background:#252525;color:#ccc;font-size:13px;font-weight:600;cursor:pointer;text-transform:capitalize;transition:all 0.15s;">
                    Economy
                  </button>
                  <button onclick="calcSetTier('standard')" id="calc-tier-standard"
                    style="flex:1;padding:10px;border-radius:6px;border:2px solid #444;background:#B8860B;border-color:#B8860B;color:#fff;font-size:13px;font-weight:600;cursor:pointer;text-transform:capitalize;transition:all 0.15s;">
                    Standard
                  </button>
                  <button onclick="calcSetTier('luxury')" id="calc-tier-luxury"
                    style="flex:1;padding:10px;border-radius:6px;border:2px solid #444;background:#252525;color:#ccc;font-size:13px;font-weight:600;cursor:pointer;text-transform:capitalize;transition:all 0.15s;">
                    Luxury
                  </button>
                </div>
              </div>

              {%- comment -%} Foundation {%- endcomment -%}
              <div style="margin-bottom:18px;">
                <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Foundation</label>
                <select id="calc-foundation" onchange="calcUpdate()"
                  style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;">
                  <option value="slab">Concrete Slab</option>
                  <option value="crawl">Crawl Space (+8%)</option>
                  <option value="basement">Full Basement (+20%)</option>
                </select>
              </div>

              {%- comment -%} Location {%- endcomment -%}
              <div style="margin-bottom:24px;">
                <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Nearest City</label>
                <select id="calc-location" onchange="calcUpdate()"
                  style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;">
                </select>
              </div>

              {%- comment -%} Preview hidden — costs revealed after contact form submit {%- endcomment -%}
              <div id="calc-preview-owner" style="display:none;"></div>
              <div id="calc-preview-gc" style="display:none;"></div>
              <div id="calc-preview-savings" style="display:none;"></div>

              <button onclick="calcNextStep()"
                style="width:100%;padding:14px;background:linear-gradient(135deg,#B8860B,#DAA520);border:none;border-radius:6px;color:#fff;font-size:15px;font-weight:700;cursor:pointer;">
                Get My Full Estimate →
              </button>
            </div>

            {%- comment -%} ── STEP 2: LEAD FORM ─────────────────────────── {%- endcomment -%}
            <div id="calc-step-form" style="display:none;">
              <div style="background:#B8860B1a;border:1px solid #B8860B55;border-radius:8px;padding:14px;margin-bottom:20px;">
                <p style="color:#DAA520;font-size:13px;font-weight:600;margin:0;">📊 Your estimate is ready! Fill in your info to see the full breakdown.</p>
              </div>

              <div style="display:flex;flex-direction:column;gap:14px;">
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Full Name *</label>
                  <input id="calc-name" type="text" placeholder="Your full name"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;">
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Email Address *</label>
                  <input id="calc-email" type="email" placeholder="your@email.com"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;">
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Phone Number *</label>
                  <input id="calc-phone" type="tel" placeholder="(555) 123-4567"
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;">
                  <label style="display:flex;align-items:flex-start;gap:8px;margin-top:8px;cursor:pointer;">
                    <input type="checkbox" style="margin-top:2px;accent-color:#B8860B;flex-shrink:0;">
                    <span style="color:#666;font-size:11px;line-height:1.4;">You are opting into marketing texts from Barnhaus Steel Builders. Msg frequency may vary. Standard msg & data rates may apply. Reply STOP to opt out.</span>
                  </label>
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:8px;">Where are you in your project?</label>
                  <div style="display:flex;flex-direction:column;gap:10px;">
                    <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;">
                      <input type="radio" name="calc-stage" value="gathering_ideas" style="margin-top:2px;accent-color:#B8860B;flex-shrink:0;">
                      <span style="color:#ccc;font-size:13px;line-height:1.4;">I'm just starting to gather ideas.</span>
                    </label>
                    <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;">
                      <input type="radio" name="calc-stage" value="concept_budget" style="margin-top:2px;accent-color:#B8860B;flex-shrink:0;">
                      <span style="color:#ccc;font-size:13px;line-height:1.4;">I have a rough idea and need a 3D Concept & Budget Study.</span>
                    </label>
                    <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;">
                      <input type="radio" name="calc-stage" value="ready_for_bid" style="margin-top:2px;accent-color:#B8860B;flex-shrink:0;">
                      <span style="color:#ccc;font-size:13px;line-height:1.4;">I have full plans and am ready for a construction bid.</span>
                    </label>
                  </div>
                </div>
                <div>
                  <label style="color:#ccc;font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Project Details (Optional)</label>
                  <textarea id="calc-message" rows="3" placeholder="Timeline, questions, special requirements..."
                    style="width:100%;background:#252525;border:1px solid #444;border-radius:6px;padding:10px 12px;color:#fff;font-size:14px;box-sizing:border-box;resize:vertical;"></textarea>
                </div>
              </div>

              <div id="calc-form-error" style="display:none;background:#7f1d1d33;border:1px solid #ef444455;border-radius:6px;padding:10px 14px;margin-top:14px;">
                <p style="color:#f87171;font-size:13px;margin:0;" id="calc-form-error-msg"></p>
              </div>

              <div style="display:flex;gap:10px;margin-top:20px;">
                <button onclick="calcBackStep()"
                  style="padding:12px 20px;background:none;border:1px solid #444;border-radius:6px;color:#aaa;font-size:14px;cursor:pointer;">
                  ← Back
                </button>
                <button onclick="calcSubmit()" id="calc-submit-btn"
                  style="flex:1;padding:14px;background:linear-gradient(135deg,#B8860B,#DAA520);border:none;border-radius:6px;color:#fff;font-size:15px;font-weight:700;cursor:pointer;">
                  Get Instant Estimate
                </button>
              </div>
            </div>

            {%- comment -%} ── STEP 3: RESULTS ──────────────────────────── {%- endcomment -%}
            <div id="calc-step-results" style="display:none;">
              <div style="background:#14532d33;border:1px solid #22c55e55;border-radius:8px;padding:14px;margin-bottom:20px;">
                <p id="calc-results-thanks" style="color:#4ade80;font-size:13px;font-weight:600;margin:0;">✅ Your estimate is ready!</p>
              </div>

              <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;">
                <div style="background:linear-gradient(135deg,#B8860B22,#DAA52022);border:1px solid #B8860B44;border-radius:8px;padding:16px;">
                  <div style="color:#aaa;font-size:12px;margin-bottom:4px;">Owner-Builder Cost</div>
                  <div id="res-owner" style="color:#DAA520;font-size:1.8rem;font-weight:700;"></div>
                  <div style="color:#999;font-size:12px;margin-top:4px;">With our Blueprint & Roadmap system</div>
                </div>
                <div style="background:#25252588;border:1px solid #333;border-radius:8px;padding:16px;">
                  <div style="color:#aaa;font-size:12px;margin-bottom:4px;">General Contractor Cost</div>
                  <div id="res-gc" style="color:#fff;font-size:1.4rem;font-weight:600;"></div>
