{% comment %}Barnhaus Design Concierge — floating pulsing widget{% endcomment %}

<div id="barnhaus-overlay" aria-modal="true" role="dialog" aria-label="Design Concierge">
  <div id="barnhaus-panel">
    <button id="barnhaus-close-btn" onclick="barnhausClose()" aria-label="Close">✕</button>
    <iframe
      id="barnhaus-iframe"
      src=""
      title="Barnhaus Design Concierge"
      allow="camera; microphone"
    ></iframe>
  </div>
</div>

<div id="barnhaus-fab" onclick="barnhausOpen()">
  <div id="barnhaus-fab-ring"></div>
  <div id="barnhaus-fab-inner">
    <span id="barnhaus-fab-icon">✏️</span>
    <span id="barnhaus-fab-label">Want to make changes?</span>
  </div>
</div>

<style>
  /* Floating button */
  #barnhaus-fab {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 99998;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #B8860B, #DAA520);
    color: #1a1a1a;
    border-radius: 50px;
    padding: 13px 20px 13px 16px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 4px 20px rgba(184,134,11,0.5);
    animation: barnhausPulse 2.2s ease-in-out infinite;
    user-select: none;
    border: none;
    outline: none;
  }
  #barnhaus-fab:hover {
    animation: none;
    transform: scale(1.05);
    box-shadow: 0 6px 28px rgba(184,134,11,0.7);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  #barnhaus-fab-icon {
    font-size: 18px;
    line-height: 1;
  }
  #barnhaus-fab-label {
    white-space: nowrap;
  }

  /* Pulse ring */
  #barnhaus-fab-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50px;
    border: 2px solid rgba(218,165,32,0.6);
    animation: barnhausRing 2.2s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes barnhausPulse {
    0%, 100% { box-shadow: 0 4px 20px rgba(184,134,11,0.5); }
    50% { box-shadow: 0 4px 32px rgba(184,134,11,0.85); }
  }
  @keyframes barnhausRing {
    0% { opacity: 0.8; transform: scale(1); }
    70% { opacity: 0; transform: scale(1.18); }
    100% { opacity: 0; transform: scale(1.18); }
  }

  /* Overlay */
  #barnhaus-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    z-index: 99999;
    align-items: flex-end;
    justify-content: center;
  }
  #barnhaus-overlay.active { display: flex; }

  #barnhaus-panel {
    background: #1a1a1a;
    width: 100%;
    max-width: 700px;
    height: 85vh;
    border-radius: 20px 20px 0 0;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  #barnhaus-close-btn {
    position: absolute;
    top: 14px;
    right: 18px;
    background: rgba(0,0,0,0.45);
    border: 1px solid #444;
    color: #aaa;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 16px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #barnhaus-iframe {
    flex: 1;
    width: 100%;
    border: none;
    background: #1a1a1a;
  }

  @media (min-width: 768px) {
    #barnhaus-overlay { align-items: center; padding: 24px; }
    #barnhaus-panel { height: 88vh; border-radius: 20px; }
  }
</style>

<script>
  (function () {
    var CONCIERGE_BASE = 'https://modify.barnhaussteelbuilders.com';
    var handle = {{ product.handle | json }};
    var loaded = false;
    var fab = document.getElementById('barnhaus-fab');

    // Hide FAB initially
    fab.style.opacity = '0';
    fab.style.pointerEvents = 'none';
    fab.style.transform = 'translateY(16px)';
    fab.style.transition = 'opacity 0.4s ease, transform 0.4s ease';

    // Show FAB when description scrolls into view
    var trigger = document.querySelector('.product-description');
    if (trigger && 'IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            fab.style.opacity = '1';
            fab.style.pointerEvents = 'auto';
            fab.style.transform = 'translateY(0)';
            observer.disconnect();
          }
        });
      }, { threshold: 0.1 });
      observer.observe(trigger);
    } else {
      // Fallback: always show
      fab.style.opacity = '1';
      fab.style.pointerEvents = 'auto';
      fab.style.transform = 'translateY(0)';
    }

    function barnhausOpen() {
      if (!loaded) {
        document.getElementById('barnhaus-iframe').src =
          CONCIERGE_BASE + '?mode=widget&handle=' + encodeURIComponent(handle);
        loaded = true;
      }
      document.getElementById('barnhaus-overlay').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function barnhausClose() {
      document.getElementById('barnhaus-overlay').classList.remove('active');
      document.body.style.overflow = '';
    }

    document.getElementById('barnhaus-overlay').addEventListener('click', function (e) {
      if (e.target === this) barnhausClose();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') barnhausClose();
    });

    window.barnhausOpen = barnhausOpen;
    window.barnhausClose = barnhausClose;
  })();
</script>
