{% comment %}Barnhaus Design Concierge — sticky bottom bar{% endcomment %}

<div id="barnhaus-overlay" aria-modal="true" role="dialog" aria-label="Design Concierge">
  <div id="barnhaus-panel">
    <button id="barnhaus-close-btn" onclick="barnhausClose()" aria-label="Close">✕</button>
    <iframe
      id="barnhaus-iframe"
      src=""
      title="Barnhaus Design Concierge"
      allow="camera; microphone"
    ></iframe>
  </div>
</div>

<a id="barnhaus-bar" href="tel:+18309718825">
  <span id="barnhaus-bar-call">📞 Call us now</span>
  <span id="barnhaus-bar-phone">(830) 971-8825</span>
</a>

<style>
  #barnhaus-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99998;
    background: linear-gradient(90deg, #1a1a1a 0%, #222 100%);
    border-top: 1px solid #B8860B;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 12px 20px;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(100%);
    transition: opacity 0.4s ease, transform 0.4s ease, visibility 0s linear 0.4s;
    font-family: 'Inter', sans-serif;
  }
  #barnhaus-bar.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  #barnhaus-bar:hover {
    background: linear-gradient(90deg, #222 0%, #2a2a2a 100%);
  }
  #barnhaus-bar { text-decoration: none; }
  #barnhaus-bar-call {
    background: #DAA520;
    color: #111;
    font-size: 15px;
    font-weight: 800;
    padding: 10px 22px;
    border-radius: 999px;
    white-space: nowrap;
  }
  #barnhaus-bar:active #barnhaus-bar-call { background: #B8860B; }
  /* Hide the call bar whenever a full-screen overlay is open (calc modal, style drawer, gate modal) */
  body.bh-overlay-open #barnhaus-bar { display: none !important; }
  #barnhaus-bar-phone {
    display: none;
    color: #ccc;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Subtle pulse on the gold border */
  @keyframes barnhausBorderPulse {
    0%, 100% { border-top-color: #B8860B; }
    50% { border-top-color: #DAA520; }
  }
  #barnhaus-bar.visible {
    animation: barnhausBorderPulse 2.5s ease-in-out infinite;
  }

  /* Overlay */
  #barnhaus-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.72);
    z-index: 99999;
    align-items: flex-end;
    justify-content: center;
  }
  #barnhaus-overlay.active { display: flex; }

  #barnhaus-panel {
    background: #1a1a1a;
    width: 100%;
    max-width: 700px;
    height: 85vh;
    border-radius: 20px 20px 0 0;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  #barnhaus-close-btn {
    position: absolute;
    top: 14px;
    right: 18px;
    background: rgba(0,0,0,0.45);
    border: 1px solid #444;
    color: #aaa;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 16px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #barnhaus-iframe {
    flex: 1;
    width: 100%;
    border: none;
    background: #1a1a1a;
  }

  @media (min-width: 768px) {
    #barnhaus-overlay { align-items: center; padding: 24px; }
    #barnhaus-panel { height: 88vh; border-radius: 20px; }
    /* Desktop: show the number next to the button */
    #barnhaus-bar-phone { display: inline; }
  }


</style>

<script>
  (function () {
    var CONCIERGE_BASE = 'https://modify.barnhaussteelbuilders.com';
    var handle = {{ product.handle | json }};
    var loaded = false;
    var bar = document.getElementById('barnhaus-bar');

    // MOD CONCIERGE LIVE — the bar opens the new step-by-step Mod Concierge.
    // Set MODTEST = false to roll back to the old popup chat instantly.
    var MODTEST = new URLSearchParams(window.location.search).get('modtest') === '1';
    if (MODTEST) {
      var pc = document.getElementById('barnhaus-close-btn');
      if (pc) pc.style.display = 'none';
    }

    // Show after 10 seconds
    setTimeout(function() {
      bar.classList.add('visible');
    }, 8000);

    function barnhausOpen() {
      if (!loaded) {
        document.getElementById('barnhaus-iframe').src = MODTEST
          ? 'https://customize.barnhaussteelbuilders.com/?plan=' + encodeURIComponent(handle) + '&embed=1'
          : CONCIERGE_BASE + '?mode=widget&handle=' + encodeURIComponent(handle);
        loaded = true;
      }
      document.getElementById('barnhaus-overlay').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    // New app's in-frame close button
    window.addEventListener('message', function (e) {
      if (e && e.data && e.data.type === 'modConciergeClose') barnhausClose();
    });

    function barnhausClose() {
      document.getElementById('barnhaus-overlay').classList.remove('active');
      document.body.style.overflow = '';
    }

    document.getElementById('barnhaus-overlay').addEventListener('click', function(e) {
      if (e.target === this) barnhausClose();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') barnhausClose();
    });

    window.barnhausOpen = barnhausOpen;
    window.barnhausClose = barnhausClose;

    // Hide bar when #image-lightbox or cart drawer is open — poll since elements may not exist at script run time
    const barnhausBar = document.getElementById('barnhaus-bar');
    setInterval(function() {
      if (!barnhausBar) return;
      const lb = document.getElementById('image-lightbox');
      const cart = document.getElementById('cart-drawer');
      const shouldHide = (lb && lb.classList.contains('active')) || (cart && cart.classList.contains('active'));
      barnhausBar.style.display = shouldHide ? 'none' : '';
    }, 150);
  })();
</script>
